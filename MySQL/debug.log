n            h.put(s.charAt(i),h.getOrDefault(s.charAt(i),0)+1);\\n        }\\n        for(int i=0;i<n;i++)\\n        {\\n            int count=h.get(s.charAt(i));\\n            if(count<k)\\n            {\\n                int l=helper(s.substring(0,i),k);\\n                int r=helper(s.substring(i+1),k);\\n                return Math.max(l,r);\\n            }\\n\\n        }\\n        return s.length();\\n    }\\n}","compare_result":"11111111111111111111111111111111111111","title_slug":"longest-substring-with-at-least-k-repeating-characters","has_notes":false,"flag_type":1,"frontend_id":406},{"id":2103891465,"question_id":395,"lang":"java","lang_name":"Java","time":"4\xc2\xa0weeks","timestamp":1786521736,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2103891465/","is_pending":"Not Pending","title":"Longest Substring with At Least K Repeating Characters","memory":"N/A","code":"class Solution {\\n    public int longestSubstring(String s, int k) {\\n        HashMap<Character,Integer> h=new HashMap<>();\\n        int l=0;\\n        for(int r=0;r<s.length();r++)\\n        {\\n            h.put(s.charAt(r),h.getOrDefault(s.charAt(r),0)+1);\\n        }\\n        for(Map.Entry<Character,Integer> entry:h.entrySet())\\n        {\\n            if(entry.getValue()>=k)\\n            {\\n                l+= entry.getValue();\\n            }\\n        }\\n        // System.out.print(l);\\n        return l;\\n    }\\n}","compare_result":"11111100001000000000100100011101010011","title_slug":"longest-substring-with-at-least-k-repeating-characters","has_notes":false,"flag_type":1,"frontend_id":405},{"id":2103762933,"question_id":3225,"lang":"java","lang_name":"Java","time":"4\xc2\xa0weeks","timestamp":1786514738,"status":10,"status_display":"Accepted","runtime":"70 ms","url":"/submissions/detail/2103762933/","is_pending":"Not Pending","title":"Length of Longest Subarray With at Most K Frequency","memory":"101.4 MB","code":"class Solution {\\n    public int maxSubarrayLength(int[] nums, int k) {\\n        HashMap<Integer, Integer> map = new HashMap<>();\\n        int left = 0;\\n        int maxLength = 0;\\n\\n        for (int right = 0; right < nums.length; right++) {\\n            map.put(nums[right], map.getOrDefault(nums[right], 0) + 1);\\n\\n            while (map.get(nums[right]) > k) {\\n                map.put(nums[left], map.get(nums[left]) - 1);\\n                left++;\\n            }\\n\\n            maxLength = Math.max(maxLength, right - left + 1);\\n        }\\n\\n        return maxLength;\\n    }\\n}","compare_result":"","title_slug":"length-of-longest-subarray-with-at-most-k-frequency","has_notes":false,"flag_type":1,"frontend_id":404},{"id":2103516772,"question_id":3225,"lang":"java","lang_name":"Java","time":"4\xc2\xa0weeks, 1\xc2\xa0day","timestamp":1786496111,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2103516772/","is_pending":"Not Pending","title":"Length of Longest Subarray With at Most K Frequency","memory":"N/A","code":"class Solution {\\n    public int maxSubarrayLength(int[] nums, int k) {\\n        HashMap<Integer,Integer> h=new HashMap<>();\\n        int n=nums.length;\\n        int length=0;\\n        for(int num:nums)\\n        {\\n            int cc=h.getOrDefault(num,0)+1;\\n            if(cc<=k)\\n            {\\n                h.put(num,cc);\\n            }\\n            else\\n            {\\n                break;\\n            }\\n        }\\n        for(Map.Entry<Integer,Integer> entry: h.entrySet())\\n        {\\n            length+=entry.getValue();\\n        }\\n        return length;\\n\\n        \\n    }\\n}","compare_result":"","title_slug":"length-of-longest-subarray-with-at-most-k-frequency","has_notes":false,"flag_type":1,"frontend_id":403},{"id":2103515744,"question_id":3225,"lang":"java","lang_name":"Java","time":"4\xc2\xa0weeks, 1\xc2\xa0day","timestamp":1786495943,"status":11,"status_display":"Wrong Answer",