6,"question_id":2079,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1753033009,"status":10,"status_display":"Accepted","runtime":"110 ms","url":"/submissions/detail/1705045996/","is_pending":"Not Pending","title":"Delete Duplicate Folders in System","memory":"73.8 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    static class Node {\\n        String name;\\n        TreeMap<String, Node> children;\\n        String signature;\\n\\n        public Node(String name) {\\n            this.name = name;\\n            this.children = new TreeMap<>();\\n        }\\n    }\\n\\n    public List<List<String>> deleteDuplicateFolder(List<List<String>> paths) {\\n        Node root = new Node(\\"\\");\\n        for (List<String> path : paths) {\\n            Node curr = root;\\n            for (String folder : path) {\\n                curr.children.putIfAbsent(folder, new Node(folder));\\n                curr = curr.children.get(folder);\\n            }\\n        }\\n\\n        Map<String, Integer> countMap = new HashMap<>();\\n        dfs(root, countMap);\\n\\n        List<List<String>> result = new ArrayList<>();\\n        List<String> currentPath = new ArrayList<>();\\n        for (Node child : root.children.values()) {\\n            dfs2(child, currentPath, result, countMap);\\n        }\\n        return result;\\n    }\\n\\n    private void dfs(Node node, Map<String, Integer> countMap) {\\n        if (node.children.isEmpty()) {\\n            node.signature = \\"\\";\\n            return;\\n        }\\n        StringBuilder sb = new StringBuilder();\\n        for (Node child : node.children.values()) {\\n            dfs(child, countMap);\\n            sb.append(child.name).append(\'(\').append(child.signature).append(\')\');\\n        }\\n        node.signature = sb.toString();\\n        countMap.put(node.signature, countMap.getOrDefault(node.signature, 0) + 1);\\n    }\\n\\n    private void dfs2(Node node, List<String> currentPath, List<List<String>> result, Map<String, Integer> countMap) {\\n        if (!node.children.isEmpty() && countMap.getOrDefault(node.signature, 0) >= 2) {\\n            return;\\n        }\\n        currentPath.add(node.name);\\n        result.add(new ArrayList<>(currentPath));\\n        for (Node child : node.children.values()) {\\n            dfs2(child, currentPath, result, countMap);\\n        }\\n        currentPath.remove(currentPath.size() - 1);\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"delete-duplicate-folders-in-system","has_notes":false,"flag_type":1,"frontend_id":158},{"id":1703673207,"question_id":1350,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1752937941,"status":10,"status_display":"Accepted","runtime":"42 ms","url":"/submissions/detail/1703673207/","is_pending":"Not Pending","title":"Remove Sub-Folders from the Filesystem","memory":"55.2 MB","code":"class Solution {\\n    public List<String> removeSubfolders(String[] folder) {\\n        Arrays.sort(folder);\\n        ArrayList<String> a=new ArrayList<>();\\n        a.add(folder[0]);\\n        int n=folder.length;\\n        for(int i=1;i<n;i++)\\n        {\\n            if(!folder[i].startsWith(a.get(a.size()-1)+\\"/\\"))\\n            {\\n                a.add(folder[i]);\\n            }\\n        }\\n        return a;\\n    }\\n}","compare_result":"11111111111111111111111111111111111","title_slug":"remove-sub-folders-from-the-filesystem","has_notes":false,"flag_type":1,"frontend_id":157},{"id":1702605381,"question_id":2267,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1752854868,"status":10,"status_display":"Accepted","runtime":"125 ms","url":"/submissions/detail/1702605381/","is_pending":"Not Pending","title":"Minimum Difference in Sums After Removal of Elements","memory":"78.6 MB","code":"class Solution {\\n public long minimumDifference(int[] nums) {\\n     int n = nums.length, k = n / 3;\\n     long[] leftMins = new long[n];   // sum of k smallest from left\\n     long[] rightMaxs = new long[n];  // sum of k largest from right\\n     long leftSum = 0, rightSum = 0, minDiff = Long.MAX_VALUE;\\n\\n     PriorityQueue<Integer> maxLeftHeap = new PriorityQueue<>((a, b) -> b - a); // max-heap\\n     PriorityQueue<Integer> minRightHeap = new PriorityQueue<>();              // min-heap\\n\\n     // Build leftMins\\n     for (int i = 0; i < k; i++) {\\n         maxLeftHeap.offer(nums[i]);\\n         leftSum += nums[i];\\n     }\\n     leftMins[k - 1] = leftSum;\\n\\n     for (int i = k; i < n - k; i++) {\\n         int x = nums[i];\\n         if (x < maxLeftHeap.peek()) {\\n             leftSum += x - maxLeftHeap.poll();\\n             maxLeftHeap.offer(x);\\n         }\\n         leftMins[i] = leftSum;\\n     }\\n\\n     // Build rightMaxs\\n     for (int i = n - 1; i >= n - k; i--) {\\n         minRightHeap.offer(nums[i]);\\n         rightSum += nums[i];\\n     }\\n     rightMaxs[n - k] = rightSum;\\n\\n     for (int i = n - k - 1; i >= k - 1; i--) {\\n         int x = nums[i];\\n         if (x > minRightHeap.peek()) {\\n             rightSum += x - minRightHeap.poll();\\n             minRightHeap.offer(x);\\n         }\\n         rightMaxs[i] = rightSum;\\n     }\\n\\n     // Find minimum difference\\n     for (int i = k - 1; i < n - k; i++) {\\n         minDiff = Math.min(minDiff, leftMins[i] - rightMaxs[i + 1]);\\n     }\\n\\n     return minDiff;\\n }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"minimum-difference-in-sums-after-removal-of-elements","has_notes":false,"flag_type":1,"frontend_id":156},{"id":1701391318,"question_id":3491,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1752763358,"status":10,"status_display":"Accepted","runtime":"49 ms","url":"/submissions/detail/1701391318/","is_pending":"Not Pending","title":"Find the Maximum Length of Valid Subsequence II","memory":"44.7 MB","code":"class Solution {\\n    public int maximumLength(int[] nums, int k) {\\n        int max=0;\\n        for(int i=0;i<k;i++)\\n        {\\n            int dp[]=new int[k];\\n            for(int num:nums)\\n            {\\n                int cm=num%k;\\n                int pm=(k+i-cm)%k;\\n                dp[cm]=Math.max(dp[cm],dp[pm]+1);\\n                max=Math.max(max,dp[cm]);\\n            }\\n        }\\n        return max;\\n        \\n    }\\n}","compare_result":"","title_slug":"find-the-maximum-length-of-valid-subsequence-ii","has_notes":false,"flag_type":1,"frontend_id":155},{"id":1700693927,"question_id":3491,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1752715055,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1700693927/","is_pending":"Not Pending","title":"Find the Maximum Length of Valid Subsequence II","memory":"N/A","code":"class Solution {\\n    public int maximumLength(int[] nums, int k) {\\n        int ec=0;\\n        int oc=0;\\n        for(int i:nums)\\n        {\\n            if(i%2==0)\\n            {\\n                ec++;\\n            }\\n            else\\n            {\\n                oc++;\\n            }\\n        }\\n        int edp=0;\\n        int odp=0;\\n        for(int i:nums)\\n        {\\n            if(i%2==0)\\n            {\\n                edp=Math.max(edp,odp+1);\\n            }\\n            else\\n            {\\n                odp=Math.max(odp,edp+1);\\n            }\\n        }\\n        return Math.max(Math.max(ec,oc),Math.max(edp,odp));\\n    }\\n}","compare_result":"","title_slug":"find-the-maximum-length-of-valid-subsequence-ii","has_notes":false,"flag_type":1,"frontend_id":154},{"id":1700693470,"question_id":3491,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0