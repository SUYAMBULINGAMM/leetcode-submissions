2026-09-10 11:02:31,541 [DEBUG] leetcode.py:152 - b'{"submissions_dump":[{"id":1623608929,"question_id":868,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746190579,"status":10,"status_display":"Accepted","runtime":"384 ms","url":"/submissions/detail/1623608929/","is_pending":"Not Pending","title":"Push Dominoes","memory":"19.5 MB","code":"class Solution:\\n    def pushDominoes(self, dominoes):\\n        n = len(dominoes)\\n        forces = [0] * n  # Array to track forces\\n\\n        # Left-to-right pass (handling \'R\')\\n        force = 0\\n        for i in range(n):\\n            if dominoes[i] == \'R\':\\n                force = n  # Strong positive force\\n            elif dominoes[i] == \'L\':\\n                force = 0  # Reset force\\n            else:\\n                force = max(force - 1, 0)  # Gradually decrease force\\n            forces[i] += force\\n        \\n        # Right-to-left pass (handling \'L\')\\n        force = 0\\n        for i in range(n - 1, -1, -1):\\n            if dominoes[i] == \'L\':\\n                force = n  # Strong negative force\\n            elif dominoes[i] == \'R\':\\n                force = 0  # Reset force\\n            else:\\n                force = max(force - 1, 0)  # Gradually decrease force\\n            forces[i] -= force\\n        \\n        # Construct final result\\n        result = []\\n        for f in forces:\\n            if f > 0:\\n                result.append(\'R\')\\n            elif f < 0:\\n                result.append(\'L\')\\n            else:\\n                result.append(\'.\')\\n        \\n        return \\"\\".join(result)\\n\\n# Example usage\\nsolution = Solution()\\nprint(solution.pushDominoes(\\"RR.L\\"))  # Output: \\"RR.L\\"\\nprint(solution.pushDominoes(\\".L.R...LR..L..\\"))  # Output: \\"LL.RR.LLRRLL..\\"\\n","compare_result":"11111111111111111111111111111111111111111111","title_slug":"push-dominoes","has_notes":false,"flag_type":1,"frontend_id":20},{"id":1623607160,"question_id":1,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746190403,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1623607160/","is_pending":"Not Pending","title":"Two Sum","memory":"13.1 MB","code":"class Solution:\\n    def twoSum(self, nums, target):\\n        num_map = {}  # Dictionary to store number and its index\\n\\n        for i, num in enumerate(nums):\\n            complement = target - num\\n            if complement in num_map:\\n                return [num_map[complement], i]  # Return indices of the pair\\n            num_map[num] = i  # Store current number and its index\\n\\n# Example usage\\nsolution = Solution()\\nprint(solution.twoSum([2, 7, 11, 15], 9))  # Output: [0, 1]\\nprint(solution.twoSum([3, 2, 4], 6))  # Output: [1, 2]\\nprint(solution.twoSum([3, 3], 6))  # Output: [0, 1]\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111","title_slug":"two-sum","has_notes":false,"flag_type":1,"frontend_id":19},{"id":1623605442,"question_id":4,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746190226,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1623605442/","is_pending":"Not Pending","title":"Median of Two Sorted Arrays","memory":"12.6 MB","code":"class Solution:\\n    def findMedianSortedArrays(self, nums1, nums2):\\n        # Ensure nums1 is the smaller array\\n        if len(nums1) > len(nums2):\\n            nums1, nums2 = nums2, nums1\\n\\n        x, y = len(nums1), len(nums2)\\n        low, high = 0, x\\n\\n        while low <= high:\\n            partitionX = (low + high) // 2\\n            partitionY = (x + y + 1) // 2 - partitionX\\n\\n            maxLeftX = float(\'-inf\') if partitionX == 0 else nums1[partitionX - 1]\\n            minRightX = float(\'inf\') if partitionX == x else nums1[partitionX]\\n\\n            maxLeftY = float(\'-inf\') if partitionY == 0 else nums2[partitionY - 1]\\n            minRightY = float(\'inf\') if partitionY == y else nums2[partitionY]\\n\\n            if maxLeftX <= minRightY and maxLeftY <= minRightX:\\n                if (x + y) % 2 == 0:\\n                    return (max(maxLeftX, maxLeftY) + min(minRightX, minRightY)) / 2.0\\n                else:\\n                    return max(maxLeftX, maxLeftY)\\n            elif maxLeftX > minRightY:\\n                high = partitionX - 1\\n            else:\\n                low = partitionX + 1\\n\\n# Example usage\\nsolution = Solution()\\nprint(solution.findMedianSortedArrays([1, 3], [2]))  # Output: 2.0\\nprint(solution.findMedianSortedArrays([1, 2], [3, 4]))  # Output: 2.5\\n","compare_result":"","title_slug":"median-of-two-sorted-arrays","has_notes":false,"flag_type":1,"frontend_id":18},{"id":1543862476,"question_id":2163,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 6\xc2\xa0months","timestamp":1739625376,"status":10,"status_display":"Accepted","runtime":"1441 ms","url":"/submissions/detail/1543862476/","is_pending":"Not Pending","title":"Kth Distinct String in an Array","memory":"45.3 MB","code":"class Solution {\\n    public String kthDistinct(String[] arr, int k) {\\n        return Arrays.stream(arr).filter(s->Arrays.stream(arr).collect(Collectors.groupingBy(e->e,Collectors.counting())).get(s)==1).skip(k-1).findFirst().orElse(\\"\\");\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111","title_slug":"kth-distinct-string-in-an-array","has_notes":false,"flag_type":1,"frontend_id":17},{"id":1543856498,"question_id":2163,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 6\xc2\xa0months","timestamp":1739624905,"status":10,"status_display":"Accepted","runtime":"1280 ms","url":"/submissions/detail/1543856498/","is_pending":"Not Pending","title":"Kth Distinct String in an Array","memory":"45.2 MB","code":"class Solution {\\n    public String kthDistinct(String[] arr, int k) {\\n        return Arrays.stream(arr).filter(s->Arrays.stream(arr).collect(Collectors.groupingBy(e->e,Collectors.counting())).get(s)==1).skip(k-1).findFirst().orElse(\\"\\");\\n        \\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111","title_slug":"kth-distinct-string-in-an-array","has_notes":false,"flag_type":1,"frontend_id":16},{"id":1506424184,"question_id":2221,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 7\xc2\xa0months","timestamp":1736702461,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1506424184/","is_pending":"Not Pending","title":"Check if a Parentheses String Can Be Valid","memory":"N/A","code":"class Solution {\\n    public boolean canBeValid(String s, String locked) {\\n        int n=s.length();\\n        if(n%2!=0)\\n        return false;\\n        int open=0,close=0,unl1=0,unl2=0;\\n        for(int i=0;i<n;i++)\\n        {\\n            if(locked.charAt(i)==\'0\')\\n              unl1++;\\n            else if(s.charAt(i)==\'(\')\\n              open++;\\n            else if(s.charAt(i)==\')\')\\n              open--;\\n            if(open+unl1<0)\\n              return false;\\n            int j=n-i-1;\\n            if(locked.charAt(j)==\'0\')\\n               unl2++;\\n            else if(s.charAt(i)==\')\')\\n               close++;\\n            else if(s.charAt(i)==\'(\')\\n               close--;\\n            if(close+unl2<0)\\n              return false;             \\n\\n        }\\n        return true;\\n    }\\n}","compare_result":"111101011011001111111111111111111110100111011111111111111101011111111111111111110101100111111111111011101111111101110111111111111111111111111100111111110111111111111011111110111111111011111110110111111011111111111111111111101110111111111101111110111111000110","title_slug":"check-if-a-parentheses-string-can-be-valid","has_notes":false,"flag_type":1,"frontend_id":15},{"id":1506400903,"question_id":1895,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 7\xc2\xa0months","timestamp":1736701135,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1506400903/","is_pending":"Not Pending","title":"Minimum Number of Operations to Move All Balls to Each Box","memory":"44.9 MB","code":"class Solution {\\n    public int[] minOperations(String boxes) {\\n        int n=boxes.length();\\n        int []d=new int[n];\\n        int pc=0;\\n        int ps=0;\\n        for(int i=0;i<n;++i)\\n        {\\n            d[i]=pc*i-ps;\\n            if(boxes.charAt(i)==\'1\')\\n            {\\n                ++pc;\\n                ps+=i;\\n            }\\n        }\\n        int sc=0;\\n        int ss=0;\\n        for(int i=n-1;i>=0;--i)\\n        {\\n            d[i]+=ss-sc*i;\\n            if(boxes.charAt(i)==\'1\')\\n            {\\n                ++sc;\\n                ss+=i;\\n            }\\n\\n        }        \\n        return d;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"minimum-number-of-operations-to-move-all-balls-to-each-box","has_notes":false,"flag_type":1,"frontend_id":14},{"id":1506389506,"question_id":2465,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 7\xc2\xa0months","timestamp":1736700467,"status":10,"status_display":"Accepted","runtime":"7 ms","url":"/submissions/detail/1506389506/","is_pending":"Not Pending","title":"Shifting Letters II","memory":"75.8 MB","code":"class Solution {\\n    public String shiftingLetters(String s, int[][] shifts) {\\n        int n=s.length();\\n        int []a=new int[n+1];\\n        for(int []b : shifts)\\n        {\\n            int st=b[0],e=b[1],d=b[2];\\n            a[st]+=(d==1 ? 1 : -1);\\n            if(e+1<n)\\n            { \\n               a[e+1]-=(d==1?1:-1);\\n            }\\n        }\\n            int c=0;\\n            for(int i=0;i<n;i++)\\n            {\\n                c+=a[i];\\n                a[i]=c;\\n            }\\n            StringBuilder r=new StringBuilder(s);\\n            for(int i=0;i<n;i++)\\n            {\\n                int net=(a[i]%26+26)%26;\\n                r.setCharAt(i,(char)(\'a\'+(s.charAt(i)-\'a\'+net)%26));\\n            }\\n            return r.toString();\\n    }\\n}","compare_result":"111111111111111111111111111111111111111","title_slug":"shifting-letters-ii","has_notes":false,"flag_type":1,"frontend_id":13},{"id":1506366464,"question_id":2059,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 7\xc2\xa0months","timestamp":1736699082,"status":10,"status_display":"Accepted","runtime":"218 ms","url":"/submissions/detail/1506366464/","is_pending":"Not Pending","title":"Unique Length-3 Palindromic Subsequences","memory":"45.2 MB","code":"class Solution {\\n    public int countPalindromicSubsequence(String s) {\\n        HashSet<Character>a=new HashSet<>();\\n        int []b=new int[s.length()];\\n        for(int i=0;i<s.length();i++)\\n        {\\n            a.add(s.charAt(i));\\n            b[i]=a.size();\\n        }\\n        int c=0;\\n        for(char d : a)\\n        {\\n            int i=-1,j=-1;\\n            for(int k=0;k<s.length();k++)\\n            {\\n                if(s.charAt(k)==d)\\n                {\\n                    if(i==-1)\\n                    {\\n                        i=k;\\n                    }\\n                    else\\n                    {\\n                        j=k;\\n                    }\\n\\n                }\\n            }\\n            if(j-i>1)\\n            {\\n                HashSet<Character>e=new HashSet<>();\\n                i++;\\n                while(i<j)\\n                {\\n                    e.add(s.charAt(i));\\n                    i++;\\n                }\\n                c+=e.size();\\n            }\\n        }\\n        return c;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"unique-length-3-palindromic-subsequences","has_notes":false,"flag_type":1,"frontend_id":12},{"id":1505967612,"question_id":2358,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 7\xc2\xa0months","timestamp":1736669490,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1505967612/","is_pending":"Not Pending","title":"Number of Ways to Split Array","memory":"58.1 MB","code":"class Solution {\\n    public int waysToSplitArray(int[] nums) {\\n        long left=0;\\n        long right=0;\\n        int c=0;\\n        for(int i=0;i<nums.length;i++)\\n        {\\n            right+=nums[i];\\n        }\\n        for(int i=0;i<nums.length-1;i++)\\n        {\\n            left+=nums[i];\\n            if(left>=right-left)\\n            {\\n                c++;\\n            }\\n        }\\n        return c;\\n        \\n\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"number-of-ways-to-split-array","has_notes":false,"flag_type":1,"frontend_id":11},{"id":1505966825,"question_id":2358,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 7\xc2\xa0months","timestamp":1736669428,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1505966825/","is_pending":"Not Pending","title":"Number of Ways to Split Array","memory":"N/A","code":"class Solution {\\n    public int waysToSplitArray(int[] nums) {\\n        int left=0;\\n        int right=0;\\n        int c=0;\\n        for(int i=0;i<nums.length;i++)\\n        {\\n            right+=nums[i];\\n        }\\n        for(int i=0;i<nums.length-1;i++)\\n        {\\n            left+=nums[i];\\n            if(left>=right-left)\\n            {\\n                c++;\\n            }\\n        }\\n        return c;\\n        \\n\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111