2026-09-10 11:02:03,127 [DEBUG] leetcode.py:152 - b'{"submissions_dump":[{"id":1671888464,"question_id":3360,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750530337,"status":10,"status_display":"Accepted","runtime":"37 ms","url":"/submissions/detail/1671888464/","is_pending":"Not Pending","title":"Minimum Deletions to Make String K-Special","memory":"46 MB","code":"class Solution {\\n    public int minimumDeletions(String word, int k) {\\n         Map<Character, Integer> freqMap = new HashMap<>();\\n        for (char c : word.toCharArray()) {\\n            freqMap.put(c, freqMap.getOrDefault(c, 0) + 1);\\n        }\\n        \\n        // Step 2: Collect frequencies and sort them\\n        List<Integer> frequencies = new ArrayList<>(freqMap.values());\\n        Collections.sort(frequencies);\\n        \\n        int minDeletions = Integer.MAX_VALUE;\\n        int n = frequencies.size();\\n        \\n        // Step 3: For each frequency, consider it as the base and calculate deletions\\n        for (int i = 0; i < n; i++) {\\n            int base = frequencies.get(i);\\n            int totalDeletions = 0;\\n            \\n            // For frequencies less than base, delete all occurrences (since we can\'t increase frequencies)\\n            for (int j = 0; j < i; j++) {\\n                totalDeletions += frequencies.get(j);\\n            }\\n            \\n            // For frequencies greater than base + k, reduce them to base + k\\n            for (int j = i; j < n; j++) {\\n                if (frequencies.get(j) > base + k) {\\n                    totalDeletions += frequencies.get(j) - (base + k);\\n                }\\n            }\\n            \\n            if (totalDeletions < minDeletions) {\\n                minDeletions = totalDeletions;\\n            }\\n        }\\n        \\n        return minDeletions;\\n        \\n    }\\n}","compare_result":"","title_slug":"minimum-deletions-to-make-string-k-special","has_notes":false,"flag_type":1,"frontend_id":120},{"id":1669610639,"question_id":2387,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750349799,"status":10,"status_display":"Accepted","runtime":"33 ms","url":"/submissions/detail/1669610639/","is_pending":"Not Pending","title":"Partition Array Such That Maximum Difference Is K","memory":"56.8 MB","code":"class Solution {\\n    public int partitionArray(int[] nums, int k) {\\n        Arrays.sort(nums);\\n        int ans = 1;\\n        int min = nums[0];\\n        for (int i = 1;  i < nums.length; i++) {\\n            if (nums[i] - min > k) {\\n                ans++;\\n                min = nums[i];\\n            }\\n        }\\n        return ans;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"partition-array-such-that-maximum-difference-is-k","has_notes":false,"flag_type":1,"frontend_id":119},{"id":1668414267,"question_id":3241,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750259166,"status":10,"status_display":"Accepted","runtime":"48 ms","url":"/submissions/detail/1668414267/","is_pending":"Not Pending","title":"Divide Array Into Arrays With Max Difference","memory":"120 MB","code":"class Solution {\\npublic:\\n    vector<vector<int>> divideArray(vector<int>& nums, int k) {\\n        sort(nums.begin(), nums.end());\\n        vector<vector<int>> result;\\n\\n        for (int i = 0; i < nums.size(); i += 3) {\\n            if (i + 2 >= nums.size() || nums[i + 2] - nums[i] > k) return {};\\n            result.push_back({nums[i], nums[i + 1], nums[i + 2]});\\n        }\\n\\n        return result;\\n    }\\n};","compare_result":"","title_slug":"divide-array-into-arrays-with-max-difference","has_notes":false,"flag_type":1,"frontend_id":118},{"id":1667204077,"question_id":3682,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750167956,"status":10,"status_display":"Accepted","runtime":"28 ms","url":"/submissions/detail/1667204077/","is_pending":"Not Pending","title":"Count the Number of Arrays with K Matching Adjacent Elements","memory":"42.3 MB","code":"class Solution {\\n  public static final int mod=1000000007;\\n    public static final int mx=100000;\\n  public static long[] f=new long[mx+1];\\n    public static long[] comb=new long[mx+1];\\nstatic{\\n  f[0]=1L;\\nfor(int i=1;i<=mx;i++){\\nf[i]=f[i-1]*i%mod;}\\n    comb[mx]=modExp(f[mx],mod-2,mod);\\n  for(int i=mx-1;i>=0;i--){\\ncomb[i]=comb[i+1]*(i+1)%mod;}\\n}\\n  public static long modExp(long base,int exp,int m){\\nlong res=1L;\\n    while(exp>0){\\nif((exp&1)==1){\\nres=(res*base)%m;}\\n  base=(base*base)%m;\\nexp>>=1;}\\n      return res;}\\npublic static long nCr(int n,int r){\\nif(r<0||r>n)return 0;\\n  return f[n]*comb[r]%mod*comb[n-r]%mod;}\\n    public int countGoodArrays(int n,int m,int k){\\nif(n==1){\\n  return(k==0)?m:0;}\\nlong pick=nCr(n-1,k);\\n    long count=pick%mod;\\ncount=(count*m)%mod;\\n  count=(count*modExp(m-1,n-k-1,mod))%mod;\\n    return(int)count;}\\n}","compare_result":"","title_slug":"count-the-number-of-arrays-with-k-matching-adjacent-elements","has_notes":false,"flag_type":1,"frontend_id":117},{"id":1666167383,"question_id":2144,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750087176,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1666167383/","is_pending":"Not Pending","title":"Maximum Difference Between Increasing Elements","memory":"41.9 MB","code":"class Solution {\\n    public int maximumDifference(int[] nums) {\\n        int a=-1;\\n        for(int i=0;i<nums.length-1;i++)\\n        {\\n            for(int j=i+1;j<nums.length;j++)\\n            {\\n                if(nums[i]<nums[j])\\n                {\\n                    a=Math.max(a,nums[j]-nums[i]);\\n                }\\n            }\\n        }\\n        return a;\\n        \\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111","title_slug":"maximum-difference-between-increasing-elements","has_notes":false,"flag_type":1,"frontend_id":116},{"id":1664983344,"question_id":1529,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1749994961,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1664983344/","is_pending":"Not Pending","title":"Max Difference You Can Get From Changing an Integer","memory":"17.8 MB","code":"class Solution:\\n    def maxDiff(self, num: int) -> int:\\n        # Step 1: Convert num to string (list for easier char substitution)\\n        s = list(str(num))\\n\\n        # Step 2: Make the max version by replacing a digit with 9\\n        for d in s:\\n            if d != \'9\':\\n                # Replace all occurrences of d with \'9\'\\n                max_s = \'\'.join(\'9\' if c == d else c for c in s)\\n                break\\n        else:\\n            # If all digits are already 9\\n            max_s = \'\'.join(s)\\n\\n        # Step 3: Make the min version\\n        if s[0] != \'1\':\\n            # Replace all instances of first digit with \'1\'\\n            d = s[0]\\n            min_s = \'\'.join(\'1\' if c == d else c for c in s)\\n        else:\\n            # Look for first digit after first that is not 0 or 1\\n            for d in s[1:]:\\n                if d != \'0\' and d != \'1\':\\n                    min_s = \'\'.join(\'0\' if c == d else c for c in s)\\n                    break\\n            else:\\n                # If no such digit found\\n                min_s = \'\'.join(s)\\n\\n        # Step 4: Convert to integers\\n        max_num = int(max_s)\\n        min_num = int(min_s)\\n\\n        # Step 5: Return the difference\\n        return max_num - min_num\\n        ","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"max-difference-you-can-get-from-changing-an-integer","has_notes":false,"flag_type":1,"frontend_id":115},{"id":1664028683,"question_id":2704,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1749918425,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1664028683/","is_pending":"Not Pending","title":"Maximum Difference by Remapping a Digit","memory":"40.6 MB","code":"class Solution {\\n    public int minMaxDifference(int num) {\\n        String str = Integer.toString(num);\\n        char[] maxChars = str.toCharArray();\\n        char[] minChars = str.toCharArray();\\n\\n        // Step 1: Find first non-9 digit for max replacement\\n        char replaceForMax = \' \';\\n        for (char c : maxChars) {\\n            if (c != \'9\') {\\n                replaceForMax = c;\\n                break;\\n            }\\n        }\\n\\n        // Step 2: Replace that digit with 9 for max\\n        for (int i = 0; i < maxChars.length; i++) {\\n            if (maxChars[i] == replaceForMax) {\\n                maxChars[i] = \'9\';\\n            }\\n        }\\n\\n        // Step 3: Replace first digit for min with 0\\n        char replaceForMin = minChars[0];\\n        for (int i = 0; i < minChars.length; i++) {\\n            if (minChars[i] == replaceForMin) {\\n                minChars[i] = \'0\';\\n            }\\n        }\\n\\n        // Step 4: Convert and calculate result\\n        int maxVal = Integer.parseInt(new String(maxChars));\\n        int minVal = Integer.parseInt(new String(minChars));\\n\\n        return maxVal - minVal;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"maximum-difference-by-remapping-a-digit","has_notes":false,"flag_type":1,"frontend_id":114},{"id":1662971709,"question_id":2720,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1749822069,"status":10,"status_display":"Accepted","runtime":"20 ms","url":"/submissions/detail/1662971709/","is_pending":"Not Pending","title":"Minimize the Maximum Difference of Pairs","memory":"56.2 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public int minimizeMax(int[] v, int p) {\\n        Arrays.sort(v); // Sort to ensure smallest differences come first\\n        int n = v.length;\\n        int lo = -1, hi = (int)1e9 + 7;\\n\\n        while (lo < hi - 1) {\\n            int mid = lo + (hi - lo) / 2;\\n            int count = 0;\\n\\n            for (int i = 1; i < n; i++) {\\n                if (v[i] - v[i - 1] <= mid) {\\n                    count++;\\n                    i++; // Skip next to ensure non-overlapping\\n                }\\n            }\\n\\n            if (count >= p) {\\n                hi = mid;\\n            } else {\\n                lo = mid;\\n            }\\n        }\\n\\n        return hi;\\n    }\\n}","compare_result":"","title_slug":"minimize-the-maximum-difference-of-pairs","has_notes":false,"flag_type":1,"frontend_id":113},{"id":1662150339,"question_id":3747,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1749748591,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1662150339/","is_pending":"Not Pending","title":"Maximum Difference Between Adjacent Elements in a Circular Array","memory":"43.8 MB","code":"class Solution {\\n    public int maxAdjacentDistance(int[] nums) {\\n        int n = nums.length;\\n        int maxa = Math.abs(nums[0] - nums[n - 1]);\\n        for (int i = 0; i < n - 1; i++) {\\n            maxa = Math.max(maxa, Math.abs(nums[i] - nums[i + 1]));\\n        }\\n        return maxa;\\n    }\\n}","compare_result":"","title_slug":"maximum-difference-between-adjacent-elements-in-a-circular-array","has_notes":false,"flag_type":1,"frontend_id":112},{"id":1661060883,"question_id":3761,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1749661822,"status":10,"status_display":"Accepted","runtime":"73 ms","url":"/submissions/detail/1661060883/","is_pending":"Not Pending","title":"Maximum Difference Between Even and Odd Frequency II","memory":"45.2 MB","code":"class Solution \\n{\\n    public int maxDifference(String s, int k) \\n    {\\n        int n = s.length();\\n        int ans = Integer.MIN_VALUE;\\n\\n        // Step 1: Try all pairs of digits a != b\\n        for (int a = 0; a <= 4; ++a) \\n        {\\n            for (int b = 0; b <= 4; ++b) \\n            {\\n                if (a == b)\\n                {\\n                    continue;\\n                } \\n\\n                // Step 2: Prefix sums of counts of a and b\\n                int[] s1 = new int[n + 1];\\n                int[] s2 = new int[n + 1];\\n                for (int i = 1; i <= n; ++i) \\n                {\\n                    s1[i] = s1[i - 1] + (s.charAt(i - 1) - \'0\' == a ? 1 : 0);\\n                    s2[i] = s2[i - 1] + (s.charAt(i - 1) - \'0\' == b ? 1 : 0);\\n                }\\n\\n                // Step 3: g[pa][pb] stores max (s2[j] - s1[j]) for each parity\\n                int[][] g = new int[2][2];\\n                for (int i = 0; i < 2; i++)\\n                {\\n                    Arrays.fill(g[i], Integer.MIN_VALUE);\\n                } \\n\\n                int j = 0;\\n\\n                // Step 4: Scan from position k\\n                for (int i = k; i <= n; i++) \\n                {\\n                    while (i - j >= k && s1[i] > s1[j] && s2[i] > s2[j]) \\n                    {\\n                        int pa = s1[j] % 2;\\n                        int pb = s2[j] % 2;\\n                        g[pa][pb] = Math.max(g[pa][pb], s2[j] - s1[j]);\\n                        j++;\\n                    }\\n\\n                    int pa = s1[i] % 2;\\n                    int pb = s2[i] % 2;\\n                    int best = g[1 - pa][pb];\\n                    if (best != Integer.MIN_VALUE) \\n                    {\\n                        ans = Math.max(ans, (s1[i] - s2[i]) + best);\\n                    }\\n                }\\n            }\\n        }\\n\\n        return ans == Integer.MIN_VALUE ? -1 : ans;\\n    }\\n}","compare_result":"","title_slug":"maximum-difference-between-even-and-odd-frequency-ii","has_notes":false,"flag_type":1,"frontend_id":111},{"id":1659768685,"question_id":3753,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1749561393,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1659768685/","is_pending":"Not Pending","title":"Maximum Difference Between Even and Odd Frequency I","memory":"42.2 MB","code":"import java.util.Arrays;\\n\\nclass Solution {\\n    public int maxDifference(String s) {\\n        char[] chars = s.toCharArray();\\n        Arrays.sort(chars);\\n\\n        int mxOdd = 0, minEven = Integer.MAX_VALUE;\\n        char cur = chars[0];\\n        int cnt = 1;\\n\\n        for (int i = 1; i < chars.length; i++) {\\n            if (chars[i] == cur) {\\n                cnt++;\\n            } else {\\n                if ((cnt & 1) == 1) {\\n                    mxOdd = Math.max(mxOdd, cnt);\\n                } else {\\n                    minEven = Math.min(minEven, cnt);\\n                }\\n                cur = chars[i];\\n                cnt = 1;\\n            }\\n        }\\n\\n        // For the last character\\n        if ((cnt & 1) == 1) {\\n            mxOdd = Math.max(mxOdd, cnt);\\n        } else {\\n            minEven = Math.min(minEven, cnt);\\n        }\\n\\n        return mxOdd - minEven;\\n    }\\n}","compare_result":"","title_slug":"maximum-difference-between-even-and-odd-frequency-i","has_notes":false,"flag_type":1,"frontend_id":110},{"id":1658666740,"question_id":440,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1749475813,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1658666740/","is_pending":"Not Pending","title":"K-th Smallest in Lexicographical Order","memory":"40.8 MB","code":"class Solution {\\n     static public int findKthNumber(int n, int K) {\\n        long k = K;\\n        int ans = solve(0, n, k);\\n        return ans;\\n    }\\n\\n    static int solve(long current, long n, long k) {\\n        if(k == 0) \\n             return (int) (current / 10);\\n\\n        for (long i = Math.max(current, 1); i < current + 10; i++) {\\n            long count = numOfChildren(i, i + 1, n);\\n            if (count >= k) \\n                return solve(i * 10, n, k - 1);\\n            k-= count;\\n        }\\n\\n        return -1;\\n    }\\n\\n    static long numOfChildren(long current, long neighbour, long n) {\\n        if (neighbour > n) {\\n            if (current > n) return 0;\\n            return n - current + 1;\\n        }\\n        return neighbour - current + numOfChildren(current * 10, neighbour * 10, n);\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"k-th-smallest-in-lexicographical-order","has_notes":false,"flag_type":1,"frontend_id":109},{"id":1657830528,"question_id":386,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1749400287,"status":10,"status_display":"Accepted","runtime":"21 ms","url":"/submissions/detail/1657830528/","is_pending":"Not Pending","title":"Lexicographical Numbers","memory":"52.7 MB","code":"class Solution {\\n    public List<Integer> lexicalOrder(int n) {\\n        List<String> r=new ArrayList<>();\\n        for(int i=1;i<=n;i++)\\n        {\\n            r.add(String.valueOf(i));\\n        }\\n        Collections.sort(r);\\n        List<Integer> o=new ArrayList<>();\\n        for(String num:r)\\n        {\\n            o.add(Integer.parseInt(num));\\n        }\\n        return o;\\n\\n\\n    }\\n}","compare_result":"111111111111111111111111111","title_slug":"lexicographical-numbers","has_notes":false,"flag_type":1,"frontend_id":108},{"id":1656604769,"question_id":3445,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1749303284,"status":10,"status_display":"Accepted","runtime":"143 ms","url":"/submissions/detail/1656604769/","is_pending":"Not Pending","title":"Lexicographically Minimum String After Removing Stars","memory":"54.7 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public String clearStars(String s) {\\n        int n = s.length();\\n        PriorityQueue<Character> pq = new PriorityQueue<>();\\n        Map<Character, Deque<Integer>> map = new HashMap<>();\\n        boolean[] keep = new boolean[n];\\n        Arrays.fill(keep, true);\\n\\n        for (int i = 0; i < n; i++) {\\n            char c = s.charAt(i);\\n            if (c == \'*\') {\\n                char smallest = pq.poll();\\n                int indexToRemove = map.get(smallest).removeLast();\\n                keep[i] = false;               // Remove \'*\'\\n                keep[indexToRemove] = false;   // Remove smallest char\\n            } else {\\n                pq.offer(c);\\n                map.putIfAbsent(c, new ArrayDeque<>());\\n                map.get(c).add(i);\\n            }\\n        }\\n\\n        StringBuilder result = new StringBuilder();\\n        for (int i = 0; i < n; i++) {\\n            if (keep[i]) {\\n                result.append(s.charAt(i));\\n            }\\n        }\\n\\n        return result.toString();\\n    }\\n}","compare_result":"","title_slug":"lexicographically-minimum-string-after-removing-stars","has_notes":false,"flag_type":1,"frontend_id":107},{"id":1655729246,"question_id":2520,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1749218752,"status":10,"status_display":"Accepted","runtime":"145 ms","url":"/submissions/detail/1655729246/","is_pending":"Not Pending","title":"Using a Robot to Print the Lexicographically Smallest String","memory":"55.2 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public String robotWithString(String s) {\\n        Stack<Character> stack = new Stack<>();\\n        int[] freq = new int[26];\\n        \\n        // Count frequency of each character\\n        for (char ch : s.toCharArray()) {\\n            freq[ch - \'a\']++;\\n        }\\n        \\n        StringBuilder t = new StringBuilder();\\n\\n        for (char ch : s.toCharArray()) {\\n            stack.push(ch);\\n            freq[ch - \'a\']--;\\n\\n            // Check if we can pop the top of the stack\\n            while (!stack.isEmpty() && stack.peek() <= smallestChar(freq)) {\\n                t.append(stack.pop());\\n            }\\n        }\\n\\n        // Append remaining characters from stack\\n        while (!stack.isEmpty()) {\\n            t.append(stack.pop());\\n        }\\n\\n        return t.toString();\\n    }\\n\\n    // Helper function to find the smallest character still available\\n    private char smallestChar(int[] freq) {\\n        for (int i = 0; i < 26; i++) {\\n            if (freq[i] > 0) {\\n                return (char) (\'a\' + i);\\n            }\\n        }\\n        return \'a\';\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111","title_slug":"using-a-robot-to-print-the-lexicographically-smallest-string","has_notes":false,"flag_type":1,"frontend_id":106},{"id":1654758190,"question_id":1058,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1749130557,"status":10,"status_display":"Accepted","runtime":"33 ms","url":"/submissions/detail/1654758190/","is_pending":"Not Pending","title":"Lexicographically Smallest Equivalent String","memory":"45.3 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public String smallestEquivalentString(String s1, String s2, String baseStr) {\\n        Map<Character, List<Character>> adj = new HashMap<>();\\n        int n = s1.length();\\n\\n        // Build the adjacency list\\n        for (int i = 0; i < n; i++) {\\n            char u = s1.charAt(i);\\n            char v = s2.charAt(i);\\n\\n            adj.computeIfAbsent(u, k -> new ArrayList<>()).add(v);\\n            adj.computeIfAbsent(v, k -> new ArrayList<>()).add(u);\\n        }\\n\\n        StringBuilder result = new StringBuilder();\\n\\n        for (char ch : baseStr.toCharArray()) {\\n            boolean[] visited = new boolean[26];\\n            char minChar = dfs(adj, ch, visited);\\n            result.append(minChar);\\n        }\\n\\n        return result.toString();\\n    }\\n\\n    private char dfs(Map<Character, List<Character>> adj, char ch, boolean[] visited) {\\n        visited[ch - \'a\'] = true;\\n        char minChar = ch;\\n\\n        for (char neighbor : adj.getOrDefault(ch, new ArrayList<>())) {\\n            if (!visited[neighbor - \'a\']) {\\n                char candidate = dfs(adj, neighbor, visited);\\n                if (candidate < minChar) {\\n                    minChar = candidate;\\n                }\\n            }\\n        }\\n\\n        return minChar;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"lexicographically-smallest-equivalent-string","has_notes":false,"flag_type":1,"frontend_id":105},{"id":1653377790,"question_id":3683,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1749016374,"status":10,"status_display":"Accepted","runtime":"13 ms","url":"/submissions/detail/1653377790/","is_pending":"Not Pending","title":"Find the Lexicographically Largest String From the Box I","memory":"45.5 MB","code":"class Solution {\\n    public String answerString(String word, int numFriends) {\\n        if(numFriends==1)\\n        return word;\\n        String res=\\"\\";\\n        int len=word.length()-numFriends+1;\\n        for(int i=0;i<word.length();i++)\\n        {\\n            String temp;\\n            if(i+len<=word.length())\\n            {\\n                temp=word.substring(i,i+len);\\n            }\\n            else\\n            {\\n                temp=word.substring(i);\\n            }\\n            if(temp.compareTo(res)>0)\\n            {\\n                res=temp;\\n            }\\n        }\\n        return res;\\n        \\n    }\\n}","compare_result":"","title_slug":"find-the-lexicographically-largest-string-from-the-box-i","has_notes":false,"flag_type":1,"frontend_id":104},{"id":1652535641,"question_id":1424,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1748939662,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1652535641/","is_pending":"Not Pending","title":"Maximum Candies You Can Get from Boxes","memory":"44 MB","code":"class Solution {\\npublic:\\n    int maxCandies(vector<int>& stat, vector<int>& choco, vector<vector<int>>& keys, vector<vector<int>>& containedBoxes, vector<int>& curBoxes) {\\n        deque<int> dq;\\n\\n        // process / put current box in queue\\n        for(int i=0;i<curBoxes.size();i++){\\n            int box_ind = curBoxes[i];\\n\\n            if(stat[box_ind] == 0){dq.push_back(box_ind);}\\n            else{dq.push_front(box_ind);}\\n        }\\n\\n        int ans = 0;\\n\\n        // start processing each box\\n        while(!dq.empty()){\\n            int box = dq.front();\\n            dq.pop_front();\\n\\n            if(stat[box]==0){\\n                break;\\n            }\\n            else if(stat[box]==1){\\n                ans += choco[box];\\n                for(auto& key:keys[box]){\\n                    stat[key] = 1;\\n                }\\n            }\\n\\n            for(auto& new_box_ind : containedBoxes[box]){\\n                if(stat[new_box_ind]==0){dq.push_back(new_box_ind);}\\n                else{dq.push_front(new_box_ind);}\\n            }\\n        }\\n\\n        return ans;\\n    }\\n};","compare_result":"111111111111111111111111111111111111","title_slug":"maximum-candies-you-can-get-from-boxes","has_notes":false,"flag_type":1,"frontend_id":103},{"id":1651363643,"question_id":135,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1748844318,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1651363643/","is_pending":"Not Pending","title":"Candy","memory":"45.8 MB","code":"class Solution {\\n    public int candy(int[] ratings) {\\n        int n=ratings.length;\\n        int cnt=0;\\n        int candies[]=new int[n];\\n        for(int i=0;i<n;i++)\\n        {\\n            candies[i]=1;\\n        } \\n        for(int i=1;i<n;i++)\\n        {\\n            if(ratings[i]>ratings[i-1])\\n            {\\n                candies[i]=candies[i-1]+1;\\n            }\\n        }\\n        for(int i=n-1;i>0;i--)\\n        {\\n            if(ratings[i-1]>ratings[i])\\n            {\\n                candies[i-1]=Math.max(candies[i]+1,candies[i-1]);\\n            }\\n            cnt+=candies[i-1];\\n        }\\n        return cnt + candies[n-1];\\n        \\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"candy","has_notes":false,"flag_type":1,"frontend_id":102},{"id":1650336621,"question_id":3201,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1748750559,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1650336621/","is_pending":"Not Pending","title":"Distribute Candies Among Children II","memory":"41.3 MB","code":"class Solution {\\n    public long distributeCandies(int n, int limit) {\\n        return mercount(n)-3 * mercount(n-(limit+1))+3*mercount(n-2*(limit+1))-mercount(n-3*(limit+1));\\n    }\\n    private long mercount(long sum)\\n    {\\n        if(sum<0)return 0;\\n        return (sum+2)*(sum+1)/2;\\n    }\\n}","compare_result":"","title_slug":"distribute-candies-among-children-ii","has_notes":false,"flag_type":1,"frontend_id":101}],"has_next":true,"last_key":""}'
