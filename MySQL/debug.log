ng_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746635553,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1627949283/","is_pending":"Not Pending","title":"Generate Parentheses","memory":"43.5 MB","code":"class Solution {\\n    public List<String> generateParenthesis(int n) {\\n        List<String> res = new ArrayList<>();\\n\\n        dfs(0, 0, \\"\\", n, res);\\n\\n        return res;        \\n    }\\n\\n    private void dfs(int openP, int closeP, String s, int n, List<String> res) {\\n        if (openP == closeP && openP + closeP == n * 2) {\\n            res.add(s);\\n            return;\\n        }\\n\\n        if (openP < n) {\\n            dfs(openP + 1, closeP, s + \\"(\\", n, res);\\n        }\\n\\n        if (closeP < openP) {\\n            dfs(openP, closeP + 1, s + \\")\\", n, res);\\n        }\\n    }    \\n}","compare_result":"11111111","title_slug":"generate-parentheses","has_notes":false,"flag_type":1,"frontend_id":56},{"id":1627948176,"question_id":19,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746635463,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1627948176/","is_pending":"Not Pending","title":"Remove Nth Node From End of List","memory":"41.7 MB","code":"class Solution {\\n    public ListNode removeNthFromEnd(ListNode head, int n) {\\n// Creating a dummy node to simplify the removal of head\\n        ListNode dummy = new ListNode(0);\\n        dummy.next = head;\\n        \\n        ListNode slow = dummy;\\n        ListNode fast = dummy;\\n        \\n        // 1. Move fast n+1 step forward so that slow is in front of the node being deleted\\n        for (int i = 0; i <= n; i++) {\\n            fast = fast.next;\\n        }\\n        \\n        // 2. Move fast to the end, and slow to the node before the deleted one\\n        while (fast != null) {\\n            slow = slow.next;\\n            fast = fast.next;\\n        }\\n        \\n        // 3. Remove the nth node from the end (slow.next points to it)\\nslow.next = slow.next.next;\\n        \\n        // Returning a new head (dummy.next could have changed if the head was deleted)\\n        return dummy.next;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"remove-nth-node-from-end-of-list","has_notes":false,"flag_type":1,"frontend_id":55},{"id":1627944453,"question_id":18,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746635174,"status":10,"status_display":"Accepted","runtime":"19 ms","url":"/submissions/detail/1627944453/","is_pending":"Not Pending","title":"4Sum","memory":"43.8 MB","code":"class Solution {\\n    public List<List<Integer>> fourSum(int[] nums, int target) {\\n        List<List<Integer>> li=new ArrayList<>();\\n        if(nums==null || nums.length<4){\\n            return li;\\n        }\\n        Arrays.sort(nums);\\n        for(int i=0;i<nums.length-3;i++){\\n            if(i>0&&nums[i]==nums[i-1]){\\n                continue;\\n            }\\n            for(int j=i+1;j<nums.length-2;j++){\\n                if(j>i+1&&nums[j]==nums[j-1]){\\n                    continue;\\n                }\\n                int left=j+1; int right=nums.length-1;\\n                while(left<right){\\n                    long sum=(long)nums[i]+nums[j]+nums[left]+nums[right];\\n                    if(sum==target){\\n                        li.add(Arrays.asList(nums[i],nums[j],nums[left],nums[right]));\\n                        while(left<right&&nums[left]==nums[left+1]){\\n                            left++;\\n                        }\\n                        while(left<right&&nums[right]==nums[right+-1]){\\n                            right--;\\n                        }\\n                        left++;\\n                        right--;\\n                    }else if(sum<target){\\n                        left++;\\n                    }else{\\n                        right--;\\n                    }\\n                }\\n            }\\n        }\\n        return li;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"4sum","has_notes":false,"flag_type":1,"frontend_id":54},{"id":1627941167,"question_id":17,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746634927,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1627941167/","is_pending":"Not Pending","title":"Letter Combinations of a Phone Number","memory":"42.1 MB","code":"class Solution {\\n    public List<String> letterCombinations(String digits) {\\n        List<String> res = new ArrayList<>();\\n        \\n        if (digits == null || digits.length() == 0) {\\n            return res;\\n        }\\n        \\n        Map<Character, String> digitToLetters = new HashMap<>();\\n        digitToLetters.put(\'2\', \\"abc\\");\\n        digitToLetters.put(\'3\', \\"def\\");\\n        digitToLetters.put(\'4\', \\"ghi\\");\\n        digitToLetters.put(\'5\', \\"jkl\\");\\n        digitToLetters.put(\'6\', \\"mno\\");\\n        digitToLetters.put(\'7\', \\"pqrs\\");\\n        digitToLetters.put(\'8\', \\"tuv\\");\\n        digitToLetters.put(\'9\', \\"wxyz\\");\\n        \\n        backtrack(digits, 0, new StringBuilder(), res, digitToLetters);\\n        \\n        return res;        \\n    }\\n\\n    private void backtrack(String digits, int idx, StringBuilder comb, List<String> res, Map<Character, String> digitToLetters) {\\n        if (idx == digits.length()) {\\n            res.add(comb.toString());\\n            return;\\n        }\\n        \\n        String letters = digitToLetters.get(digits.charAt(idx));\\n        for (char letter : letters.toCharArray()) {\\n            comb.append(letter);\\n            backtrack(digits, idx + 1, comb, res, digitToLetters);\\n            comb.deleteCharAt(comb.length() - 1);\\n        }\\n    }    \\n}","compare_result":"1111111111111111111111111","title_slug":"letter-combinations-of-a-phone-number","has_notes":false,"flag_type":1,"frontend_id":53},{"id":1627940029,"question_id":16,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746634836,"status":10,"status_display":"Accepted","runtime":"13 ms","url":"/submissions/detail/1627940029/","is_pending":"Not Pending","title":"3Sum Closest","memory":"43.1 MB","code":"class Solution {\\n    public int threeSumClosest(int[] nums, int target) {\\n        Arrays.sort(nums);\\n        int n = nums.length, closest = nums[0] + nums[1] + nums[2];\\n        for (int i = 0; i < n - 2; i++) {\\n            int l = i + 1, r = n - 1;\\n            while (l < r) {\\n                int sum = nums[i] + nums[l] + nums[r];\\n                if (Math.abs(sum - target) < Math.abs(closest - target)) {\\n                    closest = sum;\\n                }\\n                if (sum < target) l++;\\n                else if (sum > target) r--;\\n                else return sum;\\n            }\\n        }\\n        return closest;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"3sum-closest","has_notes":false,"flag_type":1,"frontend_id":52},{"id":1627938814,"question_id":15,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746634741,"status":10,"status_display":"Accepted","runtime":"32 ms","url":"/submissions/detail/1627938814/","is_pending":"Not Pending","title":"3Sum","memory":"51.8 MB","code":"class Solution {\\n    public List<List<Integer>> threeSum(int[] nums) {\\n        List<List<Integer>> ans = new ArrayList<>();\\n\\n        // Sort the array\\n        Arrays.sort(nums);\\n\\n        for (int i = 0; i < nums.length - 2; i++) {\\n            // Skip duplicate elements for i\\n            if (i > 0 && nums[i] == nums[i - 1]) {\\n                continue;\\n            }\\n\\n            int j = i + 1;\\n            int k = nums.length - 1;\\n\\n            while (j < k) {\\n                int sum = nums[i] + nums[j] + nums[k];\\n\\n                if (sum == 0) {\\n                    // Found a triplet with zero sum\\n                    ans.add(Arrays.asList(nums[i], nums[j], nums[k]));\\n\\n                    // Skip duplicate elements for j\\n                    while (j < k && nums[j] == nums[j + 1]) {\\n                        j++;\\n                    }\\n\\n                    // Skip duplicate elements for k\\n                    while (j < k && nums[k] == nums[k - 1]) {\\n                        k--;\\n                    }\\n\\n                    // Move the pointers\\n                    j++;\\n                    k--;\\n                } else if (sum < 0) {\\n                    // Sum is less than zero, increment j to increase the sum\\n                    j++;\\n                } else {\\n                    // Sum is greater than zero, decrement k to decrease the sum\\n                    k--;\\n                }\\n            }\\n        }\\n        return ans;\\n    }\\n}","compare_result":"","title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":51},{"id":1627937595,"question_id":12,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746634646,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1627937595/","is_pending":"Not Pending","title":"Integer to Roman","memory":"44.7 MB","code":"class Solution {\\n    public String intToRoman(int num) {\\n        int[] n = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};\\n        String[] s = {\\"M\\", \\"CM\\", \\"D\\", \\"CD\\", \\"C\\", \\"XC\\", \\"L\\", \\"XL\\", \\"X\\", \\"IX\\", \\"V\\", \\"IV\\", \\"I\\"};\\n        int i =0;\\n        String str = new String(); \\n        while (num>0){\\n            if (num>=n[i]){\\n                str=str+s[i];\\n                num-=n[i];\\n            } else{\\n                i++;\\n            }\\n        }\\n        return str;\\n    }\\n}","compare_result":"","title_slug":"integer-to-roman","has_notes":false,"flag_type":1,"frontend_id":50},{"id":1627936324,"question_id":11,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746634545,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1627936324/","is_pending":"Not Pending","title":"Container With Most Water","memory":"58.5 MB","code":"class Solution {\\n    public int maxArea(int[] height) {\\n        int m=0;\\n        int l=0;\\n        int r=height.length-1;\\n        while(l<r)\\n        {\\n            m=Math.max(m,(r-l)*Math.min(height[l],height[r]));\\n            if(height[l]<height[r])\\n            {\\n                l++;\\n            }\\n            else\\n            {\\n                r--;\\n            }\\n        }\\n        return m;\\n        \\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"container-with-most-water","has_notes":false,"flag_type":1,"frontend_id":49},{"id":1627931124,"question_id":8,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746634150,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1627931124/","is_pending":"Not Pending","title":"String to Integer (atoi)","memory":"42.2 MB","code":"class Solution {\\n    public int myAtoi(String s) {\\n        int i = 0, n = s.length(), sign = 1, res = 0;\\n        while (i < n && s.charAt(i) == \' \') i++;\\n        if (i < n && (s.charAt(i) == \'+\' || s.charAt(i) == \'-\')) {\\n            sign = s.charAt(i) == \'-\' ? -1 : 1;\\n            i++;\\n        }\\n        while (i < n && Character.isDigit(s.charAt(i))) {\\n            int digit = s.charAt(i) - \'0\';\\n            if (res > (Integer.MAX_VALUE - digit) / 10) {\\n                return sign == 1 ? Integer.MAX_VALUE : Integer.MIN_VALUE;\\n            }\\n            res = res * 10 + digit;\\n            i++;\\n        }\\n        return res * sign;\\n    }\\n}","compare_result":"","title_slug":"string-to-integer-atoi","has_notes":false,"flag_type":1,"frontend_id":48},{"id":1627928013,"question_id":5,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746633898,"status":10,"status_display":"Accepted","runtime":"15 ms","url":"/submissions/detail/1627928013/","is_pending":"Not Pending","title":"Longest Palindromic Substring","memory":"42.2 MB","code":"public class Solution {\\n    public String longestPalindrome(String s) {\\n        int start = 0, end = 0;\\n        for (int i = 0; i < s.length(); i++) {\\n            int len1 = expandAroundCenter(s, i, i);\\n            int len2 = expandAroundCenter(s, i, i + 1);\\n            int len = Math.max(len1, len2);\\n            if (len > end - start) {\\n                start = i - (len - 1) / 2;\\n                end = i + len / 2;\\n            }\\n        }\\n        return s.substring(start, end + 1);\\n    }\\n\\n    private int expandAroundCenter(String s, int left, int right) {\\n        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {\\n            left--;\\n            right++;\\n        }\\n        return right - left - 1;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-substring","has_notes":false,"flag_type":1,"frontend_id":47},{"id":1627435355,"question_id":3627,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746581949,"status":10,"status_display":"Accepted","runtime":"8 ms","url":"/submissions/detail/1627435355/","is_pending":"Not Pending","title":"Find Minimum Time to Reach Last Room I","memory":"45.3 MB","code":"\\nclass Solution {\\n    public int minTimeToReach(int[][] moveTime) {\\n        int rows = moveTime.length;\\n        int cols = moveTime[0].length;\\n        PriorityQueue<int[]> minHeap = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\\n        int[][] time = new int[rows][cols];\\n        \\n        for (int[] row : time) {\\n            Arrays.fill(row, Integer.MAX_VALUE);\\n        }\\n\\n        minHeap.offer(new int[]{0, 0, 0}); // time, x, y\\n        time[0][0] = 0;\\n\\n        int[][] directions = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}};\\n\\n        while (!minHeap.isEmpty()) {\\n            int[] current = minHeap.poll();\\n            int currentTime = current[0], x = current[1], y = current[2];\\n\\n            if (x == rows - 1 && y == cols - 1) {\\n                return currentTime;\\n            }\\n\\n            for (int[] dir : directions) {\\n                int newX = x + dir[0], newY = y + dir[1];\\n\\n                if (newX >= 0 && newX < rows && newY >= 0 && newY < cols) {\\n                    int waitTime = Math.max(moveTime[newX][newY] - currentTime, 0);\\n                    int newTime = currentTime + 1 + waitTime;\\n\\n                    if (newTime < time[newX][newY]) {\\n                        time[newX][newY] = newTime;\\n                        minHeap.offer(new int[]{newTime, newX, newY});\\n                    }\\n                }\\n            }\\n        }\\n\\n        return -1; // unreachable\\n    }\\n}","compare_result":"","title_slug":"find-minimum-time-to-reach-last-room-i","has_notes":false,"flag_type":1,"frontend_id":46},{"id":1626840867,"question_id":6,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746521543,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1626840867/","is_pending":"Not Pending","title":"Zigzag Conversion","memory":"45.4 MB","code":"class Solution {\\n    public String convert(String s, int numRows) {\\n       if (numRows == 1 || numRows >= s.length()) {\\n            return s;\\n        }\\n\\n        int idx = 0, d = 1;\\n        List<Character>[] rows = new ArrayList[numRows];\\n        for (int i = 0; i < numRows; i++) {\\n            rows[i] = new ArrayList<>();\\n        }\\n\\n        for (char c : s.toCharArray()) {\\n            rows[idx].add(c);\\n            if (idx == 0) {\\n                d = 1;\\n            } else if (idx == numRows - 1) {\\n                d = -1;\\n            }\\n            idx += d;\\n        }\\n\\n        StringBuilder result = new StringBuilder();\\n        for (List<Character> row : rows) {\\n            for (char c : row) {\\n                result.append(c);\\n            }\\n        }\\n\\n        return result.toString();        \\n    }\\n}","compare_result":"","title_slug":"zigzag-conversion","has_notes":false,"flag_type":1,"frontend_id":45},{"id":1626839999,"question_id":7,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746521462,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1626839999/","is_pending":"Not Pending","title":"Reverse Integer","memory":"40.6 MB","code":"class Solution {\\n    public int reverse(int x) {\\n        if(x == Integer.MAX_VALUE || x == Integer.MIN_VALUE)\\n            return 0;\\n        boolean isNeg = x < 0;\\n        int abs = isNeg ? x * (-1) : x;\\n        int n = (int) Math.log10(abs) + 1;\\n        int res = 0;\\n        for(int i = 0; i < n && abs > 0; i++){\\n            res += ((abs % 10) * Math.pow(10, n - i - 1));\\n            abs /= 10;\\n        }\\n        if(res == Integer.MAX_VALUE || res == Integer.MIN_VALUE)\\n            return 0;\\n        return isNeg ? res * (-1) : res;\\n    }\\n}","compare_result":"","title_slug":"reverse-integer","has_notes":false,"flag_type":1,"frontend_id":44},{"id":1626839628,"question_id":7,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746521425,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1626839628/","is_pending":"Not Pending","title":"Reverse Integer","memory":"N/A","code":"class Solution {\\n    public int reverse(int x) {\\n        int r=0;\\n        while(x!=0)\\n        {\\n            if(x>Integer.MAX_VALUE/10)\\n            return 0;\\n            if(x<Integer.MIN_VALUE/10)\\n            return 0;\\n            int rem=x%10;\\n            r=(r*10)+rem;\\n            x=x/10;\\n        }\\n        return r;\\n        \\n    }\\n}","compare_result":"","title_slug":"reverse-integer","has_notes":false,"flag_type":1,"frontend_id":43},{"id":1626801011,"question_id":3,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746517446,"status":10,"status_display":"Accepted","runtime":"7 ms","url":"/submissions/detail/1626801011/","is_pending":"Not Pending","title":"Longest Substring Without Repeating Characters","memory":"45.1 MB","code":"class Solution {\\n    public int lengthOfLongestSubstring(String s) {\\n        int n = s.length();\\n        int maxLength = 0;\\n        Set<Character> charSet = new HashSet<>();\\n        int left = 0;\\n        \\n        for (int right = 0; right < n; right++) {\\n            if (!charSet.contains(s.charAt(right))) {\\n                charSet.add(s.charAt(right));\\n                maxLength = Math.max(maxLength, right - left + 1);\\n            } else {\\n                while (charSet.contains(s.charAt(right))) {\\n                    charSet.remove(s.charAt(left));\\n                    left++;\\n                }\\n                charSet.add(s.charAt(right));\\n            }\\n        }\\n        \\n        return maxLength;\\n    }\\n}","compare_result":"","title_slug":"longest-substring-without-repeating-characters","has_notes":false,"flag_type":1,"frontend_id":42},{"id":1626570887,"question_id":2,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746495137,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1626570887/","is_pending":"Not Pending","title":"Add Two Numbers","memory":"44.6 MB","code":"// Definition for singly-linked list.\\n// public class ListNode {\\n//     int val;\\n//     ListNode next;\\n//     ListNode() {}\\n//     ListNode(int val) { this.val = val; }\\n//     ListNode(int val, ListNode next) { this.val = val; this.next = next; }\\n// }\\n\\nclass Solution {\\n    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {\\n        ListNode dummy = new ListNode();\\n        ListNode cur = dummy;\\n        int carry = 0;\\n        while (l1 != null || l2 != null || carry != 0) {\\n            int sum = carry;\\n            if (l1 != null) {\\n                sum += l1.val;\\n                l1 = l1.next;\\n            }\\n            if (l2 != null) {\\n                sum += l2.val;\\n                l2 = l2.next;\\n            }\\n            carry = sum / 10;\\n            cur.next = new ListNode(sum % 10);\\n            cur = cur.next;\\n        }\\n        return dummy.next;\\n    }\\n}","compare_result":"","title_slug":"add-two-numbers","has_notes":false,"flag_type":1,"frontend_id":41}],"has_next":true,"last_key":""}'
