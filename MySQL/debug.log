de":"class Solution {\\n    public int longestBalanced(String s) {\\n        int n=s.length();\\n        int m=0;\\n        for(int i=0;i<n;i++)\\n        {\\n            int a[]=new int[26];\\n            for(int j=i;j<n;j++)\\n            {\\n                a[s.charAt(j) - \'a\']++;\\n                if(isfreq(a))\\n                {\\n                    m=Math.max(m,j-i+1);\\n                }\\n            }\\n        }\\n        return m;\\n    }\\n    public static boolean isfreq(int arr[])\\n    {\\n        int v=0;\\n        for(int c:arr)\\n        {\\n            if(c == 0) continue;\\n            if(v == 0) v=c;\\n            else if(v!=c) return false;\\n        }\\n        return true;\\n    }\\n}","compare_result":"","title_slug":"longest-balanced-substring-i","has_notes":false,"flag_type":1,"frontend_id":196},{"id":1917517715,"question_id":4055,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1770948385,"status":10,"status_display":"Accepted","runtime":"280 ms","url":"/submissions/detail/1917517715/","is_pending":"Not Pending","title":"Longest Balanced Substring I","memory":"47 MB","code":"class Solution {\\n    public int longestBalanced(String s) {\\n        int n=s.length();\\n        int m=0;\\n        for(int i=0;i<n;i++)\\n        {\\n            int a[]=new int[26];\\n            for(int j=i;j<n;j++)\\n            {\\n                a[s.charAt(j) - \'a\']++;\\n                if(isfreq(a))\\n                {\\n                    m=Math.max(m,j-i+1);\\n                }\\n            }\\n        }\\n        return m;\\n    }\\n    public static boolean isfreq(int arr[])\\n    {\\n        int min=Integer.MAX_VALUE,max=0;\\n        for(int c:arr)\\n        {\\n            if(c>0)\\n            {\\n                min=Math.min(min,c);\\n                max=Math.max(max,c);\\n            }\\n        }\\n        if(min == max)\\n        {\\n            return true;\\n        }\\n        return false;\\n    }\