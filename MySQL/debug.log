\\n        {\\n            if(s.charAt(i-1) == s.charAt(i))\\n            {\\n                cg++;\\n            }\\n            else\\n            {\\n                ans+=Math.min(pg,cg);\\n                pg=cg;\\n                cg=1;\\n            }\\n        }\\n        ans+=Math.min(pg,cg);\\n        return ans;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"count-binary-substrings","has_notes":false,"flag_type":1,"frontend_id":222},{"id":1924135927,"question_id":53,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1771488447,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1924135927/","is_pending":"Not Pending","title":"Maximum Subarray","memory":"77.3 MB","code":"class Solution {\\n    public int maxSubArray(int[] nums) {\\n        int largest=nums[0];\\n        int csum=nums[0];\\n        int n=nums.length;\\n            for(int i=1;i<n;i++)\\n            {\\n                csum=Math.max(nums[i], csum+nums[i]);\\n                largest= Math.max(largest,csum);\\n            }\\n        return largest;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"maximum-subarray","has_notes":false,"flag_type":1,"frontend_id":221}],"has_next":true,"last_key":""}'
