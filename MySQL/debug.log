3168,"question_id":41,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year","timestamp":1756740582,"status":10,"status_display":"Accepted","runtime":"81 ms","url":"/submissions/detail/1755993168/","is_pending":"Not Pending","title":"First Missing Positive","memory":"58 MB","code":"class Solution {\\n    public int firstMissingPositive(int[] nums) {\\n        TreeSet<Integer> t=new TreeSet<>();\\n        for(int i:nums)\\n        {\\n            if(i>0) \\n            {\\n                t.add(i);\\n            }\\n        }\\n        if(t.size()==0) \\n        {\\n            return 1;\\n        }\\n        int max=t.last();\\n        for(int i=1;i<max;i++)\\n        {\\n            if(!t.contains(i)) return i; \\n        }\\n        return max+1;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"first-missing-positive","has_notes":false,"flag_type":1,"frontend_id":166},{"id":1729105664,"question_id":231,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1754753701,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1729105664/","is_pending":"Not Pending","title":"Power of Two","memory":"41.1 MB","code":"class Solution {\\n    public boolean isPowerOfTwo(int n) {\\n        return n>0 && (n & (n-1))==0;\\n    }\\n}","compare_result":"","title_slug":"power-of-two","has_notes":false,"flag_type":1,"frontend_id":165},{"id":1724292239,"question_id":3790,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1754393817,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1724292239/","is_pending":"Not Pending","title":"Fruits Into Baskets II","memory":"44.9 MB","code":"class Solution {\\n    public int numOfUnplacedFruits(int[] fruits, int[] baskets) {\\n        int n=fruits.length;\\n        int a=n;\\n        for(int i=0;i<n;i++)\\n        {\\n            for(int j=0;j<n;j++)\\n            {\\n                if(fruits[i]<=baskets[j])\\n                {\\n                    a--;\\n                    baskets[j]=0;\\n                    break;\\n                }\\n            }\\n        }\\n        return a;\\n    }\\n}","compare_result":"","title_slug":"fruits-into-baskets-ii","has_notes":false,"flag_type":1,"frontend_id":164},{"id":1711575752,"question_id":3789,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1753488920,"status":10,"status_display":"Accepted","runtime":"512 ms","url":"/submissions/detail/1711575752/","is_pending":"Not Pending","title":"Maximize Subarrays After Removing One Conflicting Pair","memory":"142.5 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public long maxSubarrays(int n, int[][] cp) {\\n        int m = cp.length;\\n        for (int i = 0; i < m; i++) {\\n            if (cp[i][0] > cp[i][1]) {\\n                int temp = cp[i][0];\\n                cp[i][0] = cp[i][1];\\n                cp[i][1] = temp;\\n            }\\n        }\\n        Arrays.sort(cp, Comparator.comparingInt(a -> a[0]));\\n        long[] contrib = new long[m];\\n        long ans = 1L * (n + 1) * n / 2;\\n        PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\\n        int j = m - 1;\\n        for (int i = n; i >= 1; i--) {\\n            while (j >= 0 && cp[j][0] >= i) {\\n                pq.offer(new int[]{cp[j][1], j});\\n                j--;\\n            }\\n            if (pq.isEmpty()) continue;\\n            int[] item = pq.poll();\\n            int d = item[0], idx = item[1];\\n            ans -= n - d + 1;\\n\\n            if (pq.isEmpty()) {\\n                contrib[idx] += n - d + 1;\\n            } else {\\n                int[] item2 = pq.peek();\\n                int d2 = item2[0];\\n                contrib[idx] += (d2 - 1 - d) + 1;\\n            }\\n            pq.offer(item);\\n        }\\n\\n        long res = 0;\\n        for (int i = 0; i < m; i++) {\\n            res = Math.max(res, ans + contrib[i]);\\n        }\\n        return res;\\n    }\\n}\\n","compare_result":"","title_slug":"maximize-subarrays-after-removing-one-conflicting-pair","has_notes":false,"flag_type":1,"frontend_id":163},{"id":1710321924,"question_id":3788,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1753404807,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1710321924/","is_pending":"Not Pending","title":"Maximum Unique Subarray Sum After Deletion","memory":"42.7 MB","code":"class Solution {\\n    public int maxSum(int[] nums) {\\n        // return Arrays.stream(nums).distinct().sum();\\n        int sum=0;\\n        Set<Integer> a = new HashSet<>();\\n        int max=Integer.MIN_VALUE;\\n        for (int i = 0; i < nums.length; i++) {\\n            if (nums[i] > 0) {\\n                a.add(nums[i]);\\n            }\\n            else\\n            {\\n                max=Math.max(max,nums[i]);\\n            }\\n\\n        }\\n        for(int v:a)\\n        {\\n            sum+=v;\\n        }\\n        if(a.size()>0)\\n        {\\n            return sum;\\n        }\\n        else\\n        {\\n            return max;\\n        }\\n        \\n    }\\n}","compare_result":"","title_slug":"maximum-unique-subarray-sum-after-deletion","has_notes":false,"flag_type":1,"frontend_id":162},{"id":1710307242,"question_id":2400,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 1\xc2\xa0month","timestamp":1753402696,"status":10,"status_display":"Accepted","runtime":"409 ms","url":"/submissions/detail/1710307242/","is_pending":"Not Pending","title":"Minimum Score After Removals on a Tree","memory":"71.6 MB","code":"class Solution {\\n    public int minimumScore(int[] nums, int[][] edges) {\\n        int n = nums.length;\\n        int m = edges.length;\\n\\n        List<List<Integer>> graph = new ArrayList<>();\\n        List<Set<Integer>> children = new ArrayList<>();\\n        int[] xor = nums.clone();\\n        int[] degree = new int[n];\\n\\n        for (int i = 0; i < n; i++) {\\n            graph.add(new ArrayList<>());\\n            children.add(new HashSet<>());\\n        }\\n\\n        for (int[] edge : edges) {\\n            int u = edge[0], v = edge[1];\\n            graph.get(u).add(v);\\n            graph.get(v).add(u);\\n            degree[u]++;\\n            degree[v]++;\\n        }\\n\\n        int total = 0;\\n        for (int val : nums)\\n            total ^= val;\\n\\n        boolean[] seen = new boolean[n];\\n        Queue<Integer> queue = new LinkedList<>();\\n\\n        for (int i = 0; i < n; i++) {\\n            if (degree[i] == 1) {\\n                queue.add(i);\\n                seen[i] = true;\\n            }\\n        }\\n\\n        while (!queue.isEmpty()) {\\n            int curr = queue.poll();\\n            for (int next : graph.get(curr)) {\\n                if (!seen[next]) {\\n                    children.get(next).add(curr);\\n                    for (int ch : children.get(curr)) {\\n                        children.get(next).add(ch);\\n                    }\\n                    xor[next] ^= xor[curr];\\n                }\\n                degree[next]--;\\n                if (degree[next] == 1 && !seen[next]) {\\n                    seen[next] = true;\\n                    queue.add(next);\\n                }\\n            }\\n        }\\n\\n        int minScore = Integer.MAX_VALUE;\\n\\n        for (int i = 0; i < m - 1; i++) {\\n            for (int j = i + 1; j < m; j++) {\\n                int a = edges[i][0], b = edges[i][1];\\n                if (children.get(a).contains(b)) {\\n                    int tmp = a;\\n                    a = b;\\n                    b = tmp;\\n                }\\n\\n                int c = edges[j][0], d = edges[j][1];\\n                if (children.get(c).contains(d)) {\\n                    int tmp = c;\\n                    c = d;\\n                    d = tmp;\\n                }\\n\\n                int[] parts;\\n                if (children.get(a).contains(c)) {\\n                    parts = new int[] { xor[c], xor[a] ^ xor[c], total ^ xor[a] };\\n                } else if (children.get(c).contains(a)) {\\n                    parts = new int[] { xor[a], xor[c] ^ xor[a], total ^ xor[c] };\\n                } else {\\n                    parts = new int[] { xor[a], xor[c], total ^ xor[a] ^ xor[c] };\\n                }\\n\\n                int max = Math.max(parts[0], Math.max(parts[1], parts[2]));\\n                int min = Math.min(parts[0], Math.min(parts[1], parts[2]));\\n                minScore = Math.min(minScore, max - min);\\n            }\\n        }\\n\\n        return minScore;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"minimum-score-after-removals-on-a-tree","has_notes":false,"flag_type":1,"frontend_id":161}],"has_next":true,"last_key":""}'
