(int n) {\\n        int ls=-1;\\n        int max=0;\\n        int i=0;\\n        while(n>0)\\n        {\\n            if((n & 1) == 1)\\n            {\\n                if(ls!=-1)\\n                {\\n                    max=Math.max(max,i-ls);\\n                }\\n                ls=i;\\n            }\\n            n>>=1;\\n            i++;\\n        }\\n        return max;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-gap","has_notes":false,"flag_type":1,"frontend_id":237},{"id":1927116772,"question_id":4065,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771740577,"status":10,"status_display":"Accepted","runtime":"182 ms","url":"/submissions/detail/1927116772/","is_pending":"Not Pending","title":"Count Sequences to K","memory":"55.9 MB","code":"class Solution {\\n    int[] nums;\\n    double k;\\n    int n;\\n    Map<List<Long>, Integer> dp = new HashMap<>();\\n\\n    long gcd(long a, long b){\\n        if(a<b){\\n            long temp = a;\\n            a=b;\\n            b=temp;\\n        }\\n\\n        if(b==0) return a;\\n\\n        return gcd(b, a%b);\\n    } \\n\\n    int solve(long index, long mul, long div){\\n        long x = gcd(mul, div);\\n        mul/=x;\\n        div/=x;\\n        \\n        if(index==n){\\n            return mul == k*div ? 1 : 0;   \\n        }\\n\\n        List<Long> temp = new ArrayList<>();\\n        temp.add(index);\\n        temp.add(mul);\\n        temp.add(div);\\n\\n        if(dp.containsKey(temp)) return dp.get(temp);\\n\\n        \\n\\n        int ans = 0;\\n        ans += solve(index+1, mul*nums[(int)index], div);\\n        ans += solve(index+1, mul, div*nums[(int)index]);\\n        ans += solve(index+1, mul, div);\\n\\n        dp.put(temp, ans);\\n        return ans;\\n    }\\n    \\n    public int countSequences(int[] nums, long k) {\\n        this.nums = nums;\\n        this.k = (double) k;\\n        n = nums.length;\\n        \\n        \\n        return solve(0, 1, 1);\\n    }\\n}","compare_result":"","title_slug":"count-sequences-to-k","has_notes":false,"flag_type":1,"frontend_id":236},{"id":1927116568,"question_id":4044,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771740564,"status":10,"status_display":"Accepted","runtime":"62 ms","url":"/submissions/detail/1927116568/","is_pending":"Not Pending","title":"Maximum Bitwise XOR After Rearrangement","memory":"56.1 MB","code":"class Solution {\\n    public String maximumXor(String s, String t) {\\n\\n        String str = t;\\n\\n        int ones = 0, zeros = 0;\\n        for (char c : str.toCharArray()) {\\n            if (c == \'1\') ones++;\\n            else zeros++;\\n        }\\n\\n        StringBuilder sb = new StringBuilder();\\n\\n        for (char c : s.toCharArray()) {\\n            if (c == \'1\') {\\n                if (zeros > 0) {\\n                    sb.append(\'1\'); \\n                    zeros--;\\n                } else {\\n                    sb.append(\'0\');\\n                    ones--;\\n                }\\n            } else {\\n                \\n                if (ones > 0) {\\n                    sb.append(\'1\'); \\n                    ones--;\\n                } else {\\n                    sb.append(\'0\');\\n                    zeros--;\\n                }\\n            }\\n        }\\n\\n        return sb.toString();\\n    }\\n}","compare_result":"","title_slug":"maximum-bitwise-xor-after-rearrangement","has_notes":false,"flag_type":1,"frontend_id":235},{"id":1927116372,"question_id":4226,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771740551,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/su