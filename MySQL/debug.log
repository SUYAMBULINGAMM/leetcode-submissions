tatus_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1638568804/","is_pending":"Not Pending","title":"Type of Triangle","memory":"N/A","code":"class Solution {\\n    public String triangleType(int[] nums) {\\n        if(nums[0]== nums[1] && nums[1]==nums[2])\\n        {\\n            return (\\"equilateral\\");\\n        }\\n        else if(nums[0]!=nums[1] && nums[1]!=nums[2])\\n        {\\n            return (\\"scalene\\");\\n        }\\n        else\\n        {\\n            return (\\"isosceles\\");\\n        }\\n    }\\n}","compare_result":"","title_slug":"type-of-triangle","has_notes":false,"flag_type":1,"frontend_id":78},{"id":1637405923,"question_id":2061,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747581980,"status":10,"status_display":"Accepted","runtime":"42 ms","url":"/submissions/detail/1637405923/","is_pending":"Not Pending","title":"Painting a Grid With Three Different Colors","memory":"45.1 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    static final int MOD = 1_000_000_007;\\n\\n    public int colorTheGrid(int m, int n) {\\n        List<int[]> validStates = new ArrayList<>();\\n        Map<String, Integer> stateToIndex = new HashMap<>();\\n        generateStates(m, new ArrayList<>(), validStates, stateToIndex);\\n        int totalStates = validStates.size();\\n        List<List<Integer>> compatible = new ArrayList<>();\\n        for (int i = 0; i < totalStates; i++) {\\n            compatible.add(new ArrayList<>());\\n            for (int j = 0; j < totalStates; j++) {\\n                if (isCompatible(validStates.get(i), validStates.get(j))) {\\n                    compatible.get(i).add(j);\\n                }\\n            }\\n        }\\n        long[][] dp = new long[n][totalStates];\\n        Arrays.fill(dp[0], 1L);  // first column can be any valid state\\n        for (int col = 1; col < n; col++) {\\n            for (int curr = 0; curr < totalStates; curr++) {\\n                for (int prev : compatible.get(curr)) {\\n                    dp[col][curr] = (dp[col][curr] + dp[col - 1][prev]) % MOD;\\n                }\\n            }\\n        }\\n        long result = 0;\\n        for (int i = 0; i < totalStates; i++) {\\n            result = (result + dp[n - 1][i]) % MOD;\\n        }\\n        return (int) result;\\n    }\\n    private void generateStates(int m, List<Integer> curr, List<int[]> states, Map<String, Integer> map) {\\n        if (curr.size() == m) {\\n            int[] arr = curr.stream().mapToInt(i -> i).toArray();\\n            states.add(arr);\\n            map.put(Arrays.toString(arr), states.size() - 1);\\n            return;\\n        }\\n        for (int color = 0; color < 3; color++) {\\n            if (curr.isEmpty() || curr.get(curr.size() - 1) != color) {\\n                curr.add(color);\\n                generateStates(m, curr, states, map);\\n                curr.remove(curr.size() - 1);\\n            }\\n        }\\n    }\\n    private boolean isCompatible(int[] a, int[] b) {\\n        for (int i = 0; i < a.length; i++) {\\n            if (a[i] == b[i]) return false;\\n        }\\n        return true;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"painting-a-grid-with-three-different-colors","has_notes":false,"flag_type":1,"frontend_id":77},{"id":1636590128,"question_id":75,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747502673,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1636590128/","is_pending":"Not Pending","title":"Sort Colors","memory":"41.8 MB","code":"class Solution {\\n    public void sortColors(int[] nums) {\\n        Arrays.sort(nums);\\n        \\n        \\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"sort-colors","has_notes":false,"flag_type":1,"frontend_id":76},{"id":1635124928,"question_id":3142,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747358227,"status":10,"status_display":"Accepted","runtime":"679 ms","url":"/submissions/detail/1635124928/","is_pending":"Not Pending","title":"Longest Unequal Adjacent Groups Subsequence II","memory":"167.3 MB","code":"class Solution {\\n    public List<String> getWordsInLongestSubsequence(String[] words, int[] groups) {\\n        Map<String, List<String>> dp = new HashMap<>();\\n\\n        return memo(words, groups, 0, -1, dp);\\n    }\\n\\n    private List<String> memo(String[] words, int[] groups, int idx, int prev, Map<String, List<String>> dp) {\\n        if(idx >= words.length) return new ArrayList<>();\\n        String key = idx + \\",\\" + prev;\\n\\n        if(dp.containsKey(key)) return dp.get(key);\\n\\n        List<String> skip = memo(words, groups, idx + 1, prev, dp);\\n\\n        List<String> take = new ArrayList<>();\\n        if(prev == -1 || (groups[idx] != groups[prev] && checkHammingDist(words[idx], words[prev]))) {\\n            take.add(words[idx]);\\n            take.addAll(memo(words, groups, idx + 1, idx, dp));\\n        }\\n\\n        dp.put(key, ((take.size() > skip.size()) ? take : skip));\\n        return dp.get(key);\\n    }\\n\\n    private boolean checkHammingDist(String s1, String s2) {\\n        if(s1.length() != s2.length()) return false;\\n\\n        int count = 0;\\n        for(int i = 0; i < s1.length(); i++) {\\n            if(s1.charAt(i) != s2.charAt(i)) count++;\\n\\n            if(count > 1) return false;\\n        }\\n\\n        return count <= 1;\\n    }\\n}","compare_result":"","title_slug":"longest-unequal-adjacent-groups-subsequence-ii","has_notes":false,"flag_type":1,"frontend_id":75},{"id":1634204583,"question_id":3143,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747271563,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1634204583/","is_pending":"Not Pending","title":"Longest Unequal Adjacent Groups Subsequence I","memory":"45.1 MB","code":"class Solution {\\n    public List<String> getLongestSubsequence(String[] words, int[] groups) {\\n        List<Integer> a=new ArrayList<>();\\n        a.add(0);\\n        for(int i=1;i<groups.length;i++)\\n        {\\n            if(groups[i]!=groups[i-1])\\n            {\\n                a.add(i);\\n            }\\n        }\\n        List<String> b=new ArrayList<>();\\n        for(int e:a)\\n        {\\n            b.add(words[e]);\\n        }\\n        return b;\\n    }\\n}","compare_result":"","title_slug":"longest-unequal-adjacent-groups-subsequence-i","has_notes":false,"flag_type":1,"frontend_id":74},{"id":1634204360,"question_id":3143,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747271527,"status":15,"status_display":"Runtime Error","runtime":"N/A","url":"/submissions/detail/1634204360/","is_pending":"Not Pending","title":"Longest Unequal Adjacent Groups Subsequence I","memory":"N/A","code":"class Solution {\\n    public List<String> getLongestSubsequence(String[] words, int[] groups) {\\n        List<Integer> a=new ArrayList<>();\\n        a.add(0);\\n        for(int i=1;i<groups.length;i++)\\n        {\\n            if(groups[i]!=groups[i+1])\\n            {\\n                a.add(i);\\n            }\\n        }\\n        List<String> b=new ArrayList<>();\\n        for(int e:a)\\n        {\\n            b.add(words[e]);\\n        }\\n        return b;\\n    }\\n}","compare_result":"","title_slug":"longest-unequal-adjacent-groups-subsequence-i","has_notes":false,"flag_type":1,"frontend_id":73},{"id":1633921526,"question_id":3630,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747241876,"status":10,"status_display":"Accepted","runtime":"3994 ms","url":"/submissions/detail/1633921526/","is_pending":"Not Pending","title":"Total Characters in String After Transformations II","memory":"18.7 MB","code":"MOD = 10**9 + 7\\n\\nclass Solution:\\n    def lengthAfterTransformations(self, s: str, t: int, nums: list[int]) -> int:\\n        T = self.getTransformationMatrix(nums)\\n        poweredT = self.matrixPow(T, t)\\n\\n        count = [0] * 26\\n        lengths = [0] * 26\\n\\n        for c in s:\\n            count[ord(c) - ord(\'a\')] += 1\\n\\n        for i in range(26):\\n            for j in range(26):\\n                lengths[j] = (lengths[j] + count[i] * poweredT[i][j]) % MOD\\n\\n        return sum(lengths) % MOD\\n\\n    def getTransformationMatrix(self, nums):\\n        T = [[0] * 26 for _ in range(26)]\\n        for i in range(len(nums)):\\n            for step in range(1, nums[i] + 1):\\n                T[i][(i + step) % 26] += 1\\n        return T\\n\\n    def getIdentityMatrix(self, size):\\n        I = [[0] * size for _ in range(size)]\\n        for i in range(size):\\n            I[i][i] = 1\\n        return I\\n\\n    def matrixMult(self, A, B):\\n        size = len(A)\\n        C = [[0] * size for _ in range(size)]\\n        for i in range(size):\\n            for j in range(size):\\n                for k in range(size):\\n                    C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD\\n        return C\\n\\n    def matrixPow(self, M, n):\\n        if n == 0:\\n            return self.getIdentityMatrix(len(M))\\n        if n % 2 == 1:\\n            return self.matrixMult(M, self.matrixPow(M, n - 1))\\n        half = self.matrixPow(M, n // 2)\\n        return self.matrixMult(half, half)","compare_result":"","title_slug":"total-characters-in-string-after-transformations-ii","has_notes":false,"flag_type":1,"frontend_id":72},{"id":1632367203,"question_id":2180,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747100017,"status":10,"status_display":"Accepted","runtime":"1628 ms","url":"/submissions/detail/1632367203/","is_pending":"Not Pending","title":"Maximum Number of Tasks You Can Assign","memory":"26.6 MB","code":"from sortedcontainers import SortedList\\n\\n\\nclass Solution:\\n    def maxTaskAssign(\\n        self, tasks: List[int], workers: List[int], pills: int, strength: int\\n    ) -> int:\\n        n, m = len(tasks), len(workers)\\n        tasks.sort()\\n        workers.sort()\\n\\n        def check(mid: int) -> bool:\\n            p = pills\\n            # Ordered set of workers\\n            ws = SortedList(workers[m - mid :])\\n            # Enumerate each task from largest to smallest\\n            for i in range(mid - 1, -1, -1):\\n                # If the largest element in the ordered set is greater than or equal to tasks[i]\\n                if ws[-1] >= tasks[i]:\\n                    ws.pop()\\n                else:\\n                    if p == 0:\\n                        return False\\n                    rep = ws.bisect_left(tasks[i] - strength)\\n                    if rep == len(ws):\\n                        return False\\n                    p -= 1\\n                    ws.pop(rep)\\n            return True\\n\\n        left, right, ans = 1, min(m, n), 0\\n        while left <= right:\\n            mid = (left + right) // 2\\n            if check(mid):\\n                ans = mid\\n                left = mid + 1\\n            else:\\n                right = mid - 1\\n\\n        return ans","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"maximum-number-of-tasks-you-can-assign","has_notes":false,"flag_type":1,"frontend_id":71},{"id":1632363576,"question_id":3629,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747099503,"status":10,"status_display":"Accepted","runtime":"22 ms","url":"/submissions/detail/1632363576/","is_pending":"Not Pending","title":"Total Characters in String After Transformations I","memory":"45.4 MB","code":"class Solution {\\n    int MOD = 1_000_000_007;\\n\\n    public int lengthAfterTransformations(String s, int t) {\\n        int[] freq = new int[26];\\n        for (char ch : s.toCharArray()) {\\n            freq[ch - \'a\']++;\\n        }\\n        for (int i = 0, j = 25; i < t; i++, j = (j + 25) % 26) {\\n            freq[(j + 1) % 26] = (freq[(j + 1) % 26] + freq[j]) % MOD;\\n        }\\n\\n        int sum = 0;\\n        for (int f : freq) {\\n            sum = (sum + f) % MOD;\\n        }\\n        return sum;\\n    }\\n}","compare_result":"","title_slug":"total-characters-in-string-after-transformations-i","has_notes":false,"flag_type":1,"frontend_id":70},{"id":1632078733,"question_id":2215,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1747068873,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/1632078733/","is_pending":"Not Pending","title":"Finding 3-Digit Even Numbers","memory":"44.7 MB","code":"class Solution {\\n  public int[] findEvenNumbers(int[] digits) {\\n    List<Integer> ans = new ArrayList<>();\\n    int[] count = new int[10];\\n\\n    for (final int digit : digits)\\n      ++count[digit];\\n\\n    // Try to construct `abc`.\\n    for (int a = 1; a <= 9; ++a)\\n      for (int b = 0; b <= 9; ++b)\\n        for (int c = 0; c <= 8; c += 2)\\n          if (count[a] > 0 && count[b] > (b == a ? 1 : 0) &&\\n              count[c] > (c == a ? 1 : 0) + (c == b ? 1 : 0))\\n            ans.add(a * 100 + b * 10 + c);\\n\\n    return ans.stream().mapToInt(Integer::intValue).toArray();\\n  }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"finding-3-digit-even-numbers","has_notes":false,"flag_type":1,"frontend_id":69},{"id":1630565152,"question_id":1293,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 3\xc2\xa0months","timestamp":1746927397,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1630565152/","is_pending":"Not Pending","title":"Three Consecutive Odds","memory":"42.4 MB","code":"class Solution {\\n    public boolean threeConsecutiveOdds(int[] arr) {\\n        int c=0;\\n        for(int i=0;i<arr.length;i++)\\n        {\\n            if(arr[i]%2!=0)\\n            {\\n                c++;\\n                if(c==3)\\n                {\\n                    return true;\\n                }\\n            }\\n            else\\n            {\\n                 c=0;\\n            }\\n        }\\n        return false;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111","title_slug":"three-consecutive-odds","has_notes":false,"flag_type":1,"frontend_id":68},{"id":1629728700,"question_id":3171,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746846422,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1629728700/","is_pending":"Not Pending","title":"Minimum Equal Sum of Two Arrays After Replacing Zeros","memory":"61.1 MB","code":"    class Solution{\\n    public long minSum(int[] A, int[] B) {\\n        long sa = 0, sb = 0, a0 = 0, b0 = 0;\\n        for (int a: A) {\\n            a0 += a > 0 ? 0: 1;\\n            sa += Math.max(a, 1);\\n        }\\n        for (int b: B) {\\n            b0 += b > 0 ? 0: 1;\\n            sb += Math.max(b, 1);\\n        }\\n        if (sa < sb && a0 == 0) return -1;\\n        if (sa > sb && b0 == 0) return -1;\\n        return Math.max(sa, sb);\\n    }\\n    }","compare_result":"","title_slug":"minimum-equal-sum-of-two-arrays-after-replacing-zeros","has_notes":false,"flag_type":1,"frontend_id":67},{"id":1628996444,"question_id":2180,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746757208,"status":10,"status_display":"Accepted","runtime":"1619 ms","url":"/submissions/detail/1628996444/","is_pending":"Not Pending","title":"Maximum Number of Tasks You Can Assign","memory":"26.5 MB","code":"from sortedcontainers import SortedList\\n\\n\\nclass Solution:\\n    def maxTaskAssign(\\n        self, tasks: List[int], workers: List[int], pills: int, strength: int\\n    ) -> int:\\n        n, m = len(tasks), len(workers)\\n        tasks.sort()\\n        workers.sort()\\n\\n        def check(mid: int) -> bool:\\n            p = pills\\n            # Ordered set of workers\\n            ws = SortedList(workers[m - mid :])\\n            # Enumerate each task from largest to smallest\\n            for i in range(mid - 1, -1, -1):\\n                # If the largest element in the ordered set is greater than or equal to tasks[i]\\n                if ws[-1] >= tasks[i]:\\n                    ws.pop()\\n                else:\\n                    if p == 0:\\n                        return False\\n                    rep = ws.bisect_left(tasks[i] - strength)\\n                    if rep == len(ws):\\n                        return False\\n                    p -= 1\\n                    ws.pop(rep)\\n            return True\\n\\n        left, right, ans = 1, min(m, n), 0\\n        while left <= right:\\n            mid = (left + right) // 2\\n            if check(mid):\\n                ans = mid\\n                left = mid + 1\\n            else:\\n                right = mid - 1\\n\\n        return ans","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"maximum-number-of-tasks-you-can-assign","has_notes":false,"flag_type":1,"frontend_id":66},{"id":1628995792,"question_id":3637,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746757109,"status":10,"status_display":"Accepted","runtime":"145 ms","url":"/submissions/detail/1628995792/","is_pending":"Not Pending","title":"Count Number of Balanced Permutations","memory":"55.5 MB","code":"class Solution {\\n\\n    int M = 1000000007;\\n    int totalSum;\\n    int totalEvenSpace;\\n    int totalOddSpace;\\n    int[] freqArr;\\n    int[] prefSum;\\n    long[] factArr;\\n    long[] revFactArr;\\n    long[][][] memo;\\n    String num;\\n    \\n    public int countBalancedPermutations(String num) {\\n        freqArr = new int[10];\\n        this.num = num;\\n        totalSum = 0;\\n        for(char ch: num.toCharArray()){\\n            freqArr[ch - \'0\']++;\\n            totalSum += (ch - \'0\');\\n        }\\n        totalEvenSpace = totalOddSpace = num.length() / 2;\\n        if((num.length() % 2) == 1) totalEvenSpace++;\\n        prefSum = new int[11];\\n        prefSum[0] = 0;\\n        for(int i = 1; i <= 10; i++){\\n            prefSum[i] = freqArr[i - 1] + prefSum[i - 1];\\n        }\\n        factArr = new long[num.length() + 1];\\n        revFactArr = new long[num.length() + 1];\\n        factArr[0] = 1;\\n        revFactArr[0] = 1;\\n        for(int i = 1; i <= num.length(); i++){\\n            factArr[i] = (factArr[i - 1] * i) % M;\\n            revFactArr[i] = fastPower(factArr[i], M - 2);\\n        }\\n        memo = new long[10][totalSum + 1][num.length()];\\n        for(long[][] arr: memo){\\n            for(long[] arr1: arr){\\n                Arrays.fill(arr1, -1);\\n            }\\n        }\\n        return (int) dp(0, 0, 0);    \\n    }\\n\\n    private long dp(int num, int evenSum, int evenLen){\\n        if(num == 10){\\n            if(evenSum == (totalSum - evenSum)) return 1;\\n            return 0;\\n        }\\n        if(memo[num][evenSum][evenLen] == -1){\\n            int count = freqArr[num];\\n            int evenSpaces = totalEvenSpace - evenLen;\\n            int oddSpaces = totalOddSpace - (prefSum[num] - evenLen);\\n            long ans = 0;\\n            for(int i = 0; i <= Math.min(count, evenSpaces); i++){\\n                if(count - i > oddSpaces) continue;\\n                ans = (ans + (((nCr(evenSpaces, i) * nCr(oddSpaces, count - i)) % M) * dp(num + 1, evenSum + (num * i), evenLen + i)) % M) % M;\\n            }\\n            memo[num][evenSum][evenLen] = ans;\\n        }\\n        return memo[num][evenSum][evenLen];\\n    }\\n\\n    private long nCr(int n, int r){\\n        return (((factArr[n] * revFactArr[n - r]) % M) * revFactArr[r]) % M;\\n    }\\n\\n    private long fastPower(long a, long b){\\n        if(b == 0) return 1;\\n        long halfPower = fastPower(a, b / 2);\\n        if((b % 2) == 0){\\n            return (halfPower * halfPower) % M;\\n        }\\n        return (a * ((halfPower * halfPower) % M)) % M;\\n    }\\n}","compare_result":"","title_slug":"count-number-of-balanced-permutations","has_notes":false,"flag_type":1,"frontend_id":65},{"id":1628217516,"question_id":30,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746669083,"status":10,"status_display":"Accepted","runtime":"17 ms","url":"/submissions/detail/1628217516/","is_pending":"Not Pending","title":"Substring with Concatenation of All Words","memory":"45.6 MB","code":"class Solution {\\n    public List<Integer> findSubstring(String s, String[] words) {\\n        List<Integer> ans = new ArrayList<>();\\n        int n = s.length();\\n        int m = words.length;\\n        int w = words[0].length();\\n\\n        HashMap<String,Integer> map = new HashMap<>();\\n        for(String x : words)\\n        map.put(x, map.getOrDefault(x,0)+1);\\n\\n        for(int i=0; i<w; i++){\\n            HashMap<String,Integer> temp = new HashMap<>();\\n            int count = 0;\\n            for(int j=i,k=i; j+w <= n; j=j+w){\\n                String word = s.substring(j,j+w);\\n                temp.put(word,temp.getOrDefault(word,0)+1);\\n                count++;\\n                \\n                if(count==m){\\n                    if(map.equals(temp)){\\n                        ans.add(k);\\n                    }\\n                    String remove = s.substring(k,k+w);\\n                    temp.computeIfPresent(remove, (a, b) -> (b > 1) ? b - 1 : null);\\n                    count--;\\n                    k=k+w;\\n                }\\n            }//inner for loop\\n        }//outer for loop\\n        return ans;\\n    }//method\\n}//class\\n\\n//................................................................","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"substring-with-concatenation-of-all-words","has_notes":false,"flag_type":1,"frontend_id":64},{"id":1628217069,"question_id":30,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746669021,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/1628217069/","is_pending":"Not Pending","title":"Substring with Concatenation of All Words","memory":"N/A","code":"class Solution {\\n    public List<Integer> findSubstring(String s, String[] words) {\\n        final Map<String, Integer> counts = new HashMap<>();\\n        for (final String word : words) {\\n            counts.put(word, counts.getOrDefault(word, 0) + 1);\\n        }\\n        final List<Integer> indexes = new ArrayList<>();\\n        final int n = s.length(), num = words.length, len = words[0].length();\\n        for (int i = 0; i < n - num * len + 1; i++) {\\n            final Map<String, Integer> seen = new HashMap<>();\\n            int j = 0;\\n            while (j < num) {\\n                final String word = s.substring(i + j * len, i + (j + 1) * len);\\n                if (counts.containsKey(word)) {\\n                    seen.put(word, seen.getOrDefault(word, 0) + 1);\\n                    if (seen.get(word) > counts.getOrDefault(word, 0)) {\\n                        break;\\n                    }\\n                } else {\\n                    break;\\n                }\\n                j++;\\n            }\\n            if (j == num) {\\n                indexes.add(i);\\n            }\\n        }\\n        return indexes;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111110","title_slug":"substring-with-concatenation-of-all-words","has_notes":false,"flag_type":1,"frontend_id":63},{"id":1628215553,"question_id":3628,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746668816,"status":10,"status_display":"Accepted","runtime":"251 ms","url":"/submissions/detail/1628215553/","is_pending":"Not Pending","title":"Find Minimum Time to Reach Last Room II","memory":"108.6 MB","code":"\\nclass Solution {\\n    public int minTimeToReach(int[][] moveTime) {\\n        // Store the input moveTime in a variable named roomMoveTime\\n        int[][] roomMoveTime = moveTime;  \\n        int totalRows = roomMoveTime.length;\\n        int totalCols = roomMoveTime[0].length;\\n\\n        // Priority queue to store (current_time, row, col, step_cost)\\n        PriorityQueue<int[]> priorityQueue = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\\n        priorityQueue.offer(new int[]{0, 0, 0, 1});  // Start at (0, 0) with time 0 and step cost 1\\n        \\n        int[][] minimumArrivalTime = new int[totalRows][totalCols];\\n        for (int[] row : minimumArrivalTime) {\\n            Arrays.fill(row, Integer.MAX_VALUE);\\n        }\\n        minimumArrivalTime[0][0] = 0;\\n\\n        // Directions for adjacent rooms (down, up, right, left)\\n        int[][] adjacentDirections = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}};\\n\\n        while (!priorityQueue.isEmpty()) {\\n            int[] currentState = priorityQueue.poll();\\n            int currentTime = currentState[0], currentRow = currentState[1], currentCol = currentState[2], currentStepCost = currentState[3];\\n\\n            // If we reached the target room (totalRows - 1, totalCols - 1)\\n            if (currentRow == totalRows - 1 && currentCol == totalCols - 1) {\\n                return currentTime;\\n            }\\n\\n            // Explore adjacent rooms\\n            for (int[] direction : adjacentDirections) {\\n                int nextRow = currentRow + direction[0];\\n                int nextCol = currentCol + direction[1];\\n\\n                if (nextRow >= 0 && nextRow < totalRows && nextCol >= 0 && nextCol < totalCols) {\\n                    int waitTime = Math.max(roomMoveTime[nextRow][nextCol] - currentTime, 0);\\n                    int newArrivalTime = currentTime + currentStepCost + waitTime;\\n\\n                    // Only push to the queue if we found a better arrival time\\n                    if (newArrivalTime < minimumArrivalTime[nextRow][nextCol]) {\\n                        minimumArrivalTime[nextRow][nextCol] = newArrivalTime;\\n                        int nextStepCost = (currentStepCost == 2) ? 1 : 2;\\n                        priorityQueue.offer(new int[]{newArrivalTime, nextRow, nextCol, nextStepCost});\\n                    }\\n                }\\n            }\\n        }\\n\\n        return -1; // Return -1 if the target room is unreachable\\n    }\\n}","compare_result":"","title_slug":"find-minimum-time-to-reach-last-room-ii","has_notes":false,"flag_type":1,"frontend_id":62},{"id":1627954538,"question_id":29,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746635950,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1627954538/","is_pending":"Not Pending","title":"Divide Two Integers","memory":"41.2 MB","code":"class Solution {\\n    public int divide(int dividend, int divisor) {\\n        if(dividend == divisor) return 1;\\n        if (dividend == Integer.MIN_VALUE && divisor == -1) {\\n            return Integer.MAX_VALUE;\\n        }\\n        if(divisor == 1) return dividend;\\n        if(dividend == -1) return -dividend;\\n        int sign = 1;\\n        if(dividend>0 && divisor<0) sign = -1;\\n        if(dividend<0 && divisor>0) sign = -1;\\n\\n        long n = Math.abs((long)dividend);\\n        long d = Math.abs((long)divisor);\\n        int ans = 0;\\n        while(n>=d)\\n        {\\n            int p = 0;\\n            while(n >= d<<p)\\n            p++;\\n\\n            p--;\\n            n -= d<<p;\\n            ans += 1<<p;\\n        }\\n        if(ans>=Math.pow(2,31) && sign==1) return Integer.MAX_VALUE;\\n        if(ans>=Math.pow(2,31) && sign==-1) return Integer.MIN_VALUE;\\n\\n        return ans*sign;\\n    }\\n}","compare_result":"","title_slug":"divide-two-integers","has_notes":false,"flag_type":1,"frontend_id":61}],"has_next":true,"last_key":""}'
