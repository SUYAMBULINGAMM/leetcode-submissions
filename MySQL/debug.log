um Number of Tasks You Can Assign","memory":"N/A","code":"from collections import deque\\nimport bisect\\n\\nclass Solution:\\n    def maxTaskAssign(self, tasks, workers, pills, strength):\\n        tasks.sort()\\n        workers.sort()\\n\\n        def can_complete(k):\\n            available_workers = deque(workers[-k:])\\n            remaining_pills = pills\\n\\n            for task in reversed(tasks[:k]):\\n                if available_workers and available_workers[-1] >= task:\\n                    available_workers.pop()\\n                elif remaining_pills > 0:\\n                    idx = bisect.bisect_left(available_workers, task - strength)\\n                    if idx < len(available_workers):\\n                        available_workers.popleft()\\n                        remaining_pills -= 1\\n                    else:\\n                        return False\\n                else:\\n                    return False\\n            return True\\n\\n        left, right = 0, min(len(tasks), len(workers))\\n        while left < right:\\n            mid = (left + right + 1) // 2\\n            if can_complete(mid):\\n                left = mid\\n            else:\\n                right = mid - 1\\n\\n        return left\\n\\n# Example usage:\\ntasks = [3, 2, 1]\\nworkers = [0, 3, 3]\\npills = 1\\nstrength = 1\\n\\nsolution = Solution()\\nprint(solution.maxTaskAssign(tasks, workers, pills, strength))  # Expected Output: 3\\n","compare_result":"1111111111111111111111111110111111101111111111111","title_slug":"maximum-number-of-tasks-you-can-assign","has_notes":false,"flag_type":1,"frontend_id":21}],"has_next":true,"last_key":""}'
