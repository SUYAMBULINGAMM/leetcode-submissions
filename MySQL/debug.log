2026-09-10 11:02:26,072 [DEBUG] leetcode.py:152 - b'{"submissions_dump":[{"id":1626566588,"question_id":2221,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746494530,"status":10,"status_display":"Accepted","runtime":"126 ms","url":"/submissions/detail/1626566588/","is_pending":"Not Pending","title":"Check if a Parentheses String Can Be Valid","memory":"18.4 MB","code":"class Solution:\\n    def canBeValid(self, s: str, locked: str) -> bool:\\n        def validate(s: str, locked: str, op: str) -> bool:\\n            bal, wild = 0, 0\\n            for i in range(len(s)):\\n                if locked[i] == \\"1\\":\\n                    bal += 1 if s[i] == op else -1\\n                else:\\n                    wild += 1\\n                if wild + bal < 0:\\n                    return False\\n            return bal <= wild\\n        return len(s) % 2 == 0 and validate(s, locked, \'(\') and validate(s[::-1], locked[::-1], \')\')","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"check-if-a-parentheses-string-can-be-valid","has_notes":false,"flag_type":1,"frontend_id":40},{"id":1626565366,"question_id":94,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746494353,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1626565366/","is_pending":"Not Pending","title":"Binary Tree Inorder Traversal","memory":"42.1 MB","code":"/**\\n * Definition for a binary tree node.\\n * public class TreeNode {\\n *     int val;\\n *     TreeNode left;\\n *     TreeNode right;\\n *     TreeNode() {}\\n *     TreeNode(int val) { this.val = val; }\\n *     TreeNode(int val, TreeNode left, TreeNode right) {\\n *         this.val = val;\\n *         this.left = left;\\n *         this.right = right;\\n *     }\\n * }\\n */\\nclass Solution {\\n    private List<Integer> r=new ArrayList<>();\\n    public List<Integer> inorderTraversal(TreeNode root) {\\n        if(root == null)\\n        return r;\\n        inorderTraversal(root.left);\\n        r.add(root.val);\\n        inorderTraversal(root.right);\\n        return r;\\n        \\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-tree-inorder-traversal","has_notes":false,"flag_type":1,"frontend_id":39},{"id":1626561757,"question_id":2048,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746493845,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1626561757/","is_pending":"Not Pending","title":"Build Array from Permutation","memory":"45.6 MB","code":"class Solution {\\n    public int[] buildArray(int[] nums) {\\n        int n=nums.length;\\n        int []r=new int[n];\\n        for(int i=0;i<n;i++)\\n        {\\n            r[i]=nums[nums[i]];\\n        }\\n        return r;\\n        \\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"build-array-from-permutation","has_notes":false,"flag_type":1,"frontend_id":38},{"id":1626046907,"question_id":806,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746445237,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1626046907/","is_pending":"Not Pending","title":"Domino and Tromino Tiling","memory":"17.9 MB","code":"MOD = 10**9 + 7\\n\\nclass Solution:\\n    def numTilings(self, n: int) -> int:\\n        if n == 1:\\n            return 1\\n        if n == 2:\\n            return 2\\n        \\n        dp = [0] * (n + 1)\\n        dp2 = [0] * (n + 1)\\n        dp[1], dp[2] = 1, 2\\n        dp2[2] = 1\\n        \\n        for i in range(3, n + 1):\\n            dp[i] = (dp[i-1] + dp[i-2] + 2 * dp2[i-1]) % MOD\\n            dp2[i] = (dp2[i-1] + dp[i-2]) % MOD\\n        \\n        return dp[n]\\n\\n# Example Usage:\\nsol = Solution()\\nprint(sol.numTilings(3))  # Output: 5\\nprint(sol.numTilings(1))  # Output: 1\\n\\n        \\n        ","compare_result":"111111111111111111111111111111111111111","title_slug":"domino-and-tromino-tiling","has_notes":false,"flag_type":1,"frontend_id":37},{"id":1626046336,"question_id":806,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746445177,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1626046336/","is_pending":"Not Pending","title":"Domino and Tromino Tiling","memory":"N/A","code":"class Solution {\\n    public int numTilings(int n) {\\n        int MOD = 1_000_000_07;\\n        if(n<=1)\\n        return 1;\\n        if(n==2)\\n        return 2;\\n        if(n==3)\\n        return 5;\\n        long a[] =new long [n+1];\\n        a[0]=1;a[1]=1;a[2]=2 ;a[3]=5;\\n        for(int i=4;i<=n;i++)\\n        {\\n            a[i]=(2*a[i-1]%MOD+a[i-3])%MOD;\\n        }\\n        return (int) a[n];\\n        \\n    }\\n}","compare_result":"111111111110000000000000000000000000000","title_slug":"domino-and-tromino-tiling","has_notes":false,"flag_type":1,"frontend_id":36},{"id":1625371500,"question_id":25,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746372532,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1625371500/","is_pending":"Not Pending","title":"Reverse Nodes in k-Group","memory":"18.4 MB","code":"class ListNode:\\n    def __init__(self, val=0, next=None):\\n        self.val = val\\n        self.next = next\\n\\nclass Solution:\\n    def reverseKGroup(self, head: ListNode, k: int) -> ListNode:\\n        if not head or k == 1:\\n            return head\\n\\n        dummy = ListNode(0)\\n        dummy.next = head\\n        prev_group_end = dummy\\n\\n        while True:\\n            # Find the k-th node from prev_group_end\\n            kth_node = prev_group_end\\n            for _ in range(k):\\n                kth_node = kth_node.next\\n                if not kth_node:  # Not enough nodes left to reverse\\n                    return dummy.next\\n\\n            group_end = kth_node.next  # Store next group\'s start\\n            # Reverse current k-group\\n            prev, curr = group_end, prev_group_end.next\\n            for _ in range(k):\\n                temp = curr.next\\n                curr.next = prev\\n                prev = curr\\n                curr = temp\\n\\n            # Connect previous group to reversed group\\n            temp = prev_group_end.next\\n            prev_group_end.next = prev\\n            prev_group_end = temp  # Move to next group\\n\\n        return dummy.next\\n\\n        ","compare_result":"11111111111111111111111111111111111111111111111111111111111111","title_slug":"reverse-nodes-in-k-group","has_notes":false,"flag_type":1,"frontend_id":35},{"id":1625368195,"question_id":2180,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746372250,"status":10,"status_display":"Accepted","runtime":"1745 ms","url":"/submissions/detail/1625368195/","is_pending":"Not Pending","title":"Maximum Number of Tasks You Can Assign","memory":"26.7 MB","code":"from sortedcontainers import SortedList\\n\\n\\nclass Solution:\\n    def maxTaskAssign(\\n        self, tasks: List[int], workers: List[int], pills: int, strength: int\\n    ) -> int:\\n        n, m = len(tasks), len(workers)\\n        tasks.sort()\\n        workers.sort()\\n\\n        def check(mid: int) -> bool:\\n            p = pills\\n            # Ordered set of workers\\n            ws = SortedList(workers[m - mid :])\\n            # Enumerate each task from largest to smallest\\n            for i in range(mid - 1, -1, -1):\\n                # If the largest element in the ordered set is greater than or equal to tasks[i]\\n                if ws[-1] >= tasks[i]:\\n                    ws.pop()\\n                else:\\n                    if p == 0:\\n                        return False\\n                    rep = ws.bisect_left(tasks[i] - strength)\\n                    if rep == len(ws):\\n                        return False\\n                    p -= 1\\n                    ws.pop(rep)\\n            return True\\n\\n        left, right, ans = 1, min(m, n), 0\\n        while left <= right:\\n            mid = (left + right) // 2\\n            if check(mid):\\n                ans = mid\\n                left = mid + 1\\n            else:\\n                right = mid - 1\\n\\n        return ans","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"maximum-number-of-tasks-you-can-assign","has_notes":false,"flag_type":1,"frontend_id":34},{"id":1625362864,"question_id":1227,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746371813,"status":10,"status_display":"Accepted","runtime":"19 ms","url":"/submissions/detail/1625362864/","is_pending":"Not Pending","title":"Number of Equivalent Domino Pairs","memory":"19.1 MB","code":"class Solution:\\n    def numEquivDominoPairs(self, dominoes):\\n        count = {}  # Dictionary to store frequency\\n        pairs = 0\\n\\n        for a, b in dominoes:\\n            key = (min(a, b), max(a, b))  # Normalize order\\n            if key in count:\\n                pairs += count[key]  # Add existing pairs\\n            count[key] = count.get(key, 0) + 1  # Update count\\n\\n        return pairs\\n\\n# Example usage:\\nsolution = Solution()\\ndominoes1 = [[1,2],[2,1],[3,4],[5,6]]\\ndominoes2 = [[1,2],[1,2],[1,1],[1,2],[2,2]]\\n\\nprint(solution.numEquivDominoPairs(dominoes1))  # Output: 1\\nprint(solution.numEquivDominoPairs(dominoes2))  # Output: 3\\n\\n\\n        ","compare_result":"1111111111111111111","title_slug":"number-of-equivalent-domino-pairs","has_notes":false,"flag_type":1,"frontend_id":33},{"id":1624239274,"question_id":10,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746261187,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1624239274/","is_pending":"Not Pending","title":"Regular Expression Matching","memory":"42 MB","code":"public class Solution {\\n    public boolean isMatch(String s, String p) {\\n        int m = s.length(), n = p.length();\\n        boolean[][] dp = new boolean[m + 1][n + 1];\\n\\n        dp[0][0] = true; // Empty string matches empty pattern\\n\\n        // Handle patterns like \\"a*\\", \\"b*\\", \\".*\\" that can match empty string\\n        for (int j = 2; j <= n; j++) {\\n            if (p.charAt(j - 1) == \'*\') {\\n                dp[0][j] = dp[0][j - 2]; // \'*\' eliminates preceding char\\n            }\\n        }\\n\\n        // Fill the DP table\\n        for (int i = 1; i <= m; i++) {\\n            for (int j = 1; j <= n; j++) {\\n                if (p.charAt(j - 1) == s.charAt(i - 1) || p.charAt(j - 1) == \'.\') {\\n                    dp[i][j] = dp[i - 1][j - 1]; // Direct match\\n                } else if (p.charAt(j - 1) == \'*\') {\\n                    dp[i][j] = dp[i][j - 2]; // Use \'*\' zero times\\n                    if (p.charAt(j - 2) == s.charAt(i - 1) || p.charAt(j - 2) == \'.\') {\\n                        dp[i][j] |= dp[i - 1][j]; // Use \'*\' one or more times\\n                    }\\n                }\\n            }\\n        }\\n\\n        return dp[m][n];\\n    }\\n\\n    public static void main(String[] args) {\\n        Solution solution = new Solution();\\n        System.out.println(solution.isMatch(\\"aa\\", \\"a\\"));  // Output: false\\n        System.out.println(solution.isMatch(\\"aa\\", \\"a*\\")); // Output: true\\n        System.out.println(solution.isMatch(\\"ab\\", \\".*\\")); // Output: true\\n    }\\n}\\n","compare_result":"","title_slug":"regular-expression-matching","has_notes":false,"flag_type":1,"frontend_id":32},{"id":1624209886,"question_id":2180,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746258268,"status":10,"status_display":"Accepted","runtime":"1720 ms","url":"/submissions/detail/1624209886/","is_pending":"Not Pending","title":"Maximum Number of Tasks You Can Assign","memory":"26.5 MB","code":"from sortedcontainers import SortedList\\n\\n\\nclass Solution:\\n    def maxTaskAssign(\\n        self, tasks: List[int], workers: List[int], pills: int, strength: int\\n    ) -> int:\\n        n, m = len(tasks), len(workers)\\n        tasks.sort()\\n        workers.sort()\\n\\n        def check(mid: int) -> bool:\\n            p = pills\\n            # Ordered set of workers\\n            ws = SortedList(workers[m - mid :])\\n            # Enumerate each task from largest to smallest\\n            for i in range(mid - 1, -1, -1):\\n                # If the largest element in the ordered set is greater than or equal to tasks[i]\\n                if ws[-1] >= tasks[i]:\\n                    ws.pop()\\n                else:\\n                    if p == 0:\\n                        return False\\n                    rep = ws.bisect_left(tasks[i] - strength)\\n                    if rep == len(ws):\\n                        return False\\n                    p -= 1\\n                    ws.pop(rep)\\n            return True\\n\\n        left, right, ans = 1, min(m, n), 0\\n        while left <= right:\\n            mid = (left + right) // 2\\n            if check(mid):\\n                ans = mid\\n                left = mid + 1\\n            else:\\n                right = mid - 1\\n\\n        return ans","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"maximum-number-of-tasks-you-can-assign","has_notes":false,"flag_type":1,"frontend_id":31},{"id":1624040889,"question_id":2180,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746239806,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1624040889/","is_pending":"Not Pending","title":"Maximum Number of Tasks You Can Assign","memory":"N/A","code":"from collections import deque\\n\\nclass Solution:\\n    def maxTaskAssign(self, tasks, workers, pills, strength):\\n        tasks.sort()\\n        workers.sort(reverse=True)\\n        \\n        def can_assign(k):\\n            task_idx = k - 1\\n            worker_deque = deque(workers[:k])\\n            pills_left = pills\\n            \\n            for i in range(k - 1, -1, -1):\\n                if worker_deque and worker_deque[0] >= tasks[task_idx]:\\n                    worker_deque.popleft()\\n                elif pills_left > 0 and worker_deque and worker_deque[-1] + strength >= tasks[task_idx]:\\n                    worker_deque.pop()\\n                    pills_left -= 1\\n                else:\\n                    return False\\n                task_idx -= 1\\n            return True\\n        \\n        left, right = 0, min(len(tasks), len(workers))\\n        answer = 0\\n        while left <= right:\\n            mid = (left + right) // 2\\n            if can_assign(mid):\\n                answer = mid\\n                left = mid + 1\\n            else:\\n                right = mid - 1\\n        return answer\\n","compare_result":"1111111111110000101010111100101111111111001000111","title_slug":"maximum-number-of-tasks-you-can-assign","has_notes":false,"flag_type":1,"frontend_id":30},{"id":1624039794,"question_id":1049,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746239626,"status":10,"status_display":"Accepted","runtime":"43 ms","url":"/submissions/detail/1624039794/","is_pending":"Not Pending","title":"Minimum Domino Rotations For Equal Row","memory":"13.6 MB","code":"class Solution:\\n    def minDominoRotations(self, tops, bottoms):\\n        def check(target):\\n            top_rotations = bottom_rotations = 0\\n            for i in range(len(tops)):\\n                if tops[i] != target and bottoms[i] != target:\\n                    return -1 \\n                elif tops[i] != target:\\n                    top_rotations += 1  \\n                elif bottoms[i] != target:\\n                    bottom_rotations += 1  \\n            return min(top_rotations, bottom_rotations)  \\n        \\n       \\n        rotations1 = check(tops[0])\\n        rotations2 = check(bottoms[0])\\n\\n        \\n        return rotations1 if rotations1 != -1 and rotations2 != -1 else max(rotations1, rotations2)\\n\\n\\nsolution = Solution()\\nprint(solution.minDominoRotations([2,1,2,4,2,2], [5,2,6,2,3,2]))  \\nprint(solution.minDominoRotations([3,5,1,2,3], [3,6,3,3,4]))  \\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"minimum-domino-rotations-for-equal-row","has_notes":false,"flag_type":1,"frontend_id":29},{"id":1624038516,"question_id":14,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746239417,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1624038516/","is_pending":"Not Pending","title":"Longest Common Prefix","memory":"12.6 MB","code":"class Solution:\\n    def longestCommonPrefix(self, strs):\\n        if not strs:\\n            return \\"\\"\\n\\n        prefix = strs[0]  # Start with the first word as the prefix\\n\\n        for word in strs[1:]:  # Compare it with each word in the list\\n            while not word.startswith(prefix):  # If the prefix doesn\'t match\\n                prefix = prefix[:-1]  # Reduce the prefix character by character\\n                if not prefix:  # If prefix becomes empty\\n                    return \\"\\"\\n        \\n        return prefix\\n\\n# Example usage:\\nsolution = Solution()\\nprint(solution.longestCommonPrefix([\\"flower\\",\\"flow\\",\\"flight\\"]))  # Output: \\"fl\\"\\nprint(solution.longestCommonPrefix([\\"dog\\",\\"racecar\\",\\"car\\"]))     # Output: \\"\\"\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-common-prefix","has_notes":false,"flag_type":1,"frontend_id":28},{"id":1624038265,"question_id":13,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746239375,"status":10,"status_display":"Accepted","runtime":"8 ms","url":"/submissions/detail/1624038265/","is_pending":"Not Pending","title":"Roman to Integer","memory":"12.4 MB","code":"class Solution:\\n    def romanToInt(self, s):\\n        roman_map = {\'I\': 1, \'V\': 5, \'X\': 10, \'L\': 50, \'C\': 100, \'D\': 500, \'M\': 1000}\\n        total = 0\\n        prev_value = 0\\n\\n        for char in reversed(s):  # Traverse the string from right to left\\n            current_value = roman_map[char]\\n            if current_value < prev_value:\\n                total -= current_value  # Subtraction case\\n            else:\\n                total += current_value\\n            prev_value = current_value\\n\\n        return total\\n\\n# Example usage:\\nsolution = Solution()\\nprint(solution.romanToInt(\\"III\\"))      # Output: 3\\nprint(solution.romanToInt(\\"LVIII\\"))    # Output: 58\\nprint(solution.romanToInt(\\"MCMXCIV\\"))  # Output: 1994\\n","compare_result":"","title_slug":"roman-to-integer","has_notes":false,"flag_type":1,"frontend_id":27},{"id":1624037740,"question_id":9,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746239288,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1624037740/","is_pending":"Not Pending","title":"Palindrome Number","memory":"12.6 MB","code":"class Solution:\\n    def isPalindrome(self, x):\\n        return str(x) == str(x)[::-1]\\n\\n# Example usage:\\nsolution = Solution()\\nprint(solution.isPalindrome(121))  # Output: True\\nprint(solution.isPalindrome(-121))  # Output: False\\nprint(solution.isPalindrome(10))  # Output: False\\n","compare_result":"","title_slug":"palindrome-number","has_notes":false,"flag_type":1,"frontend_id":26},{"id":1624036974,"question_id":2180,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746239159,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1624036974/","is_pending":"Not Pending","title":"Maximum Number of Tasks You Can Assign","memory":"N/A","code":"from collections import deque\\nimport bisect\\n\\nclass Solution:\\n    def maxTaskAssign(self, tasks, workers, pills, strength):\\n        # Sort tasks in ascending order so that easier tasks get assigned first\\n        tasks.sort()\\n        # Sort workers in ascending order to efficiently allocate pills to weaker workers\\n        workers.sort()\\n\\n        def can_complete(k):\\n            available_workers = deque(workers[-k:])  # Taking the k strongest workers\\n            remaining_pills = pills\\n\\n            for task in reversed(tasks[:k]):  # Matching tasks to available workers\\n                if available_workers and available_workers[-1] >= task:\\n                    available_workers.pop()\\n                elif remaining_pills > 0:\\n                    idx = bisect.bisect_left(available_workers, task - strength)\\n                    if idx < len(available_workers):\\n                        available_workers.popleft()  # Remove the weakest worker who can be boosted\\n                        remaining_pills -= 1\\n                    else:\\n                        return False  # No suitable worker found\\n                else:\\n                    return False\\n            return True\\n\\n        # Binary search to find the maximum number of tasks that can be completed\\n        left, right = 0, min(len(tasks), len(workers))\\n        while left < right:\\n            mid = (left + right + 1) // 2\\n            if can_complete(mid):\\n                left = mid\\n            else:\\n                right = mid - 1\\n\\n        return left\\n\\n# Example usage:\\ntasks = [1943,2068,4077,7832,8061,6939,6263,8917,8008,5348,8837,4753,4607,7638,9000,7222,4552,1123,9225,6896,4154,6303,3186,2325,9994,5855,8851,7377,1930,1187,5094,2689,8852,1507,1567,9575,1193,1557,8840,9075,5032,3642,6917,7968,5310,2315,7516,4776,3091,7027,1788,2007,2651,6112,4264,5644,3585,9408,7410,9605,8151,1538,6905,6759,4518,3444,5036,1589,3902,3037,1468,9179,3000,5339,6805,7394,9418,9262,2888,4708,3402,5554,8714,7393,2848,5946,9808,4301,6675,8564,6300,4359,9506,1946,9673,7412,1164,2986,2198,5144,3763,4782,8835,6994,8035,3332,2342,5243,3150,9084,6519,9798,7682,99]\\nworkers = [875,2347,939,3664,3926,4555,1947,4406,4601,3502,4964,1307,4232,2968,4572,3139,2788,1847,1208,2019,4184,1664,1747,3690,4333,891,686,1959,2218,4972,806,741,1490,4529,2909,925,2040,1234,1264,1135,3640,1455,2933,3699,2856,3074,4579,2458,2090,833,4140,4534,2336,4363,1948,4546,4155,3735,3577,2780,4874,1747,4844,3482,3053,3534,549,4500,2237,2128,1554,3210,4161,2211,950,3732,2182,1148,4368,4050,1452,1015,3192,4318,3908,2590,1103,2811,2821,690,2718,3360,2659,3315,579,3108,2979,3903,4367,1906,4964,889,4803,825,2270,4794,4825,4485,4461,1639,3857,1330,3169,2425,3694,1980]\\npills = 122\\nstrength = 3131\\n\\nsolution = Solution()\\nprint(solution.maxTaskAssign(tasks, workers, pills, strength))  # Expected Output: 143\\n","compare_result":"1111111111111111111111111110111111101111111111111","title_slug":"maximum-number-of-tasks-you-can-assign","has_notes":false,"flag_type":1,"frontend_id":25},{"id":1624035763,"question_id":2180,"lang":"python","lang_name":"Python","time":"1\xc2\xa0year, 4\xc2\xa0months","timestamp":1746238971,"status":11,"status_display":"Wrong Answer","ru