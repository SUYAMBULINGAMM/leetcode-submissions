\\n        for(int i=0;i<n;i++)\\n        {\\n            while(nums[i]-nums[j]>1)\\n            {\\n                j++;\\n            }\\n            if(nums[i]-nums[j]==1)\\n            {\\n                m=Math.max(m,i-j+1);\\n            }\\n        }\\n        return m;\\n        \\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-harmonious-subsequence","has_notes":false,"flag_type":1,"frontend_id":131},{"id":1680499868,"question_id":1621,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1751211012,"status":10,"status_display":"Accepted","runtime":"28 ms","url":"/submissions/detail/1680499868/","is_pending":"Not Pending","title":"Number of Subsequences That Satisfy the Given Sum Condition","memory":"55.5 MB","code":"class Solution {\\n    public int numSubseq(int[] nums, int target) {\\n        int mod=1000000007;\\n        int l=nums.length;\\n        Arrays.sort(nums);\\n        int[] p=new int[l];\\n        p[0]=1;\\n        for(int i=1;i<l;i++)\\n        {\\n            p[i]=(p[i-1]*2)%mod;\\n        }\\n        int left=0,r=l-1,result=0;\\n        while(left<=r)\\n        {\\n            if(nums[left]+nums[r]<=target)\\n            {\\n                result=(result+p[r-left])%mod;\\n                left++;\\n            }\\n            else\\n            {\\n                r--;\\n            }\\n        }\\n        return result;\\n        \\n        \\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111","title_slug":"number-of-subsequences-that-satisfy-the-given-sum-condition","has_notes":false,"flag_type":1,"frontend_id":130},{"id":1679387558,"question_id":2204,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1751121522,"status":10,"status_display":"Accepted","runtime":"7 ms","url":"/submissions/detail/1679387558/","is_pending":"Not Pending","title":"Find Subsequence of Length K With the Largest Sum","memory":"44.8 MB","code":"\\nclass Solution {\\n    public int[] maxSubsequence(int[] nums, int k) {\\n        // Step 1: Create array of [value, index] pairs\\n        int[][] valueWithIndex = new int[nums.length][2];\\n        for (int i = 0; i < nums.length; i++) {\\n            valueWithIndex[i] = new int[]{nums[i], i}; // Store value and its original index\\n        }\\n        \\n        // Step 2: Sort by value in descending order\\n        Arrays.sort(valueWithIndex, (a, b) -> b[0] - a[0]);\\n        // This compares values (a[0] and b[0]) and sorts bigger values first\\n        \\n        // Step 3: Take first k elements and sort them by original index\\n        Arrays.sort(valueWithIndex, 0, k, (a, b) -> a[1] - b[1]);\\n        // This sorts only the first k elements by their original indices (a[1])\\n        \\n        // Step 4: Extract the values in order\\n        int[] result = new int[k];\\n        for (int i = 0; i < k; i++) {\\n            result[i] = valueWithIndex[i][0]; // Take just the value part\\n        }\\n        \\n        return result;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"find-subsequence-of-length-k-with-the-largest-sum","has_notes":false,"flag_type":1,"frontend_id":129},{"id":1678589498,"question_id":2140,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1751048119,"status":10,"status_display":"Accepted","runtime":"667 ms","url":"/submissions/detail/1678589498/","is_pending":"Not Pending","title":"Longest Subsequence Repeated k Times","memory":"45.8 MB","code":"class Solution {\\n    public String longestSubsequenceRepeatedK(String s, int k) {\\n        String r=\\"\\";\\n        Queue<String> q=new LinkedList<>();\\n        for(q.add(\\"\\");!q.isEmpty();) {\\n            String c=q.poll();\\n            for(char ch=\'a\';ch<=\'z\';ch++) {\\n                String n=c+ch;\\n                if(isK(n,s,k)) {\\n                    r=n;\\n                    q.add(n);\\n                }\\n            }\\n        }\\n        return r;\\n    }\\n    boolean isK(String s,String t,int k) {\\n        int c=0,i=0;\\n        for(char ch:t.toCharArray()) {\\n            if(ch==s.charAt(i)) {\\n                if(++i==s.length()) {\\n                    i=0;\\n                    if(++c==k) return true;\\n                }\\n            }\\n        }\\n        return false;\\n    }\\n}","compare_result":"","title_slug":"longest-subsequence-repeated-k-times","has_notes":false,"flag_type":1,"frontend_id":128},{"id":1677389032,"question_id":2395,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750952999,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1677389032/","is_pending":"Not Pending","title":"Longest Binary Subsequence Less Than or Equal to K","memory":"41.6 MB","code":"public class Solution {\\n    public int longestSubsequence(String s, int k) {\\n        int n = s.length();\\n        int zeros = 0;\\n        int ones = 0;\\n        long value = 0;\\n        long pow = 1;\\n\\n        // Count all zeros\\n        for (char c : s.toCharArray()) {\\n            if (c == \'0\') zeros++;\\n        }\\n\\n        // Process from right to left\\n        for (int i = n - 1; i >= 0; i--) {\\n            if (s.charAt(i) == \'1\') {\\n                if (value + pow > k) {\\n                    continue; // Skip this \'1\' as it would exceed k\\n                }\\n                value += pow;\\n                ones++;\\n            }\\n            pow <<= 1;\\n            // Prevent pow from overflowing; if pow is beyond k, no more \'1\'s can be added\\n            if (pow > k) {\\n                // Once pow exceeds k, further bits can\'t be added as their value is too large\\n                break;\\n            }\\n        }\\n        return zeros + ones;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-binary-subsequence-less-than-or-equal-to-k","has_notes":false,"flag_type":1,"frontend_id":127},{"id":1676064185,"question_id":2150,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750856727,"status":10,"status_display":"Accepted","runtime":"720 ms","url":"/submissions/detail/1676064185/","is_pending":"Not Pending","title":"Kth Smallest Product of Two Sorted Arrays","memory":"55.4 MB","code":"class Solution {\\n    public long kthSmallestProduct(int[] nums1, int[] nums2, long k) {\\n        long left = -10000000000L;\\n        long right = 10000000000L;\\n        \\n        while (left < right) {\\n            long mid = left + (right - left) / 2;\\n            if (countProducts(nums1, nums2, mid) < k) {\\n                left = mid + 1;\\n            } else {\\n                right = mid;\\n            }\\n        }\\n        \\n        return left;\\n    }\\n    \\n    private long countProducts(int[] nums1, int[] nums2, long target) {\\n        long count = 0;\\n        for (int num1 : nums1) {\\n            if (num1 == 0) {\\n                if (target >= 0) count += nums2.length;\\n                continue;\\n            }\\n            \\n            int low = 0, high = nums2.length;\\n            while (low < high) {\\n                int mid = low + (high - low) / 2;\\n                long product = (long) num1 * nums2[mid];\\n                if (product <= target) {\\n                    if (num1 > 0) low = mid + 1;\\n                    else high = mid;\\n                } else {\\n                    if (num1 > 0) high = mid;\\n                    else low = mid + 1;\\n                }\\n            }\\n            \\n            count += (num1 > 0) ? low : nums2.length - low;\\n        }\\n        return count;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"kth-smallest-product-of-two-sorted-arrays","has_notes":false,"flag_type":1,"frontend_id":126},{"id":1675076144,"question_id":2320,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750780081,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1675076144/","is_pending":"Not Pending","title":"Find All K-Distant Indices in an Array","memory":"44.7 MB","code":"class Solution {\\n    public List<Integer> findKDistantIndices(int[] nums, int key, int k) {\\n        \\n        List<Integer> a=new ArrayList<>();\\n        int n=nums.length;\\n        for(int i=0;i<n;i++)\\n        {\\n            for(int j=0;j<n;j++)\\n            {\\n                if(nums[j]==key && Math.abs(i-j)<=k)\\n                {\\n                    a.add(i);\\n                    break;\\n                }\\n            }\\n        }\\n        return a;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-all-k-distant-indices-in-an-array","has_notes":false,"flag_type":1,"frontend_id":125},{"id":1673758284,"question_id":2202,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750685260,"status":10,"status_display":"Accepted","runtime":"384 ms","url":"/submissions/detail/1673758284/","is_pending":"Not Pending","title":"Sum of k-Mirror Numbers","memory":"44.7 MB","code":"class Solution {\\n\\n    long createPalindrome(long num, boolean odd) {\\n        long x = num;\\n        if (odd) x /= 10;\\n        while (x > 0) {\\n            num = num * 10 + x % 10;\\n            x /= 10;\\n        }\\n        return num;\\n    }\\n\\n    boolean isPalindrome(long num, int base) {\\n        StringBuilder sb = new StringBuilder();\\n        while (num > 0) {\\n            sb.append((char) (num % base + \'0\'));\\n            num /= base;\\n        }\\n        String s = sb.toString();\\n        int i = 0, j = s.length() - 1;\\n        while (i < j) if (s.charAt(i++) != s.charAt(j--)) return false;\\n        return true;\\n    }\\n\\n    public long kMirror(int k, int n) {\\n        long sum = 0;\\n        for (long len = 1; n > 0; len *= 10) {\\n            for (long i = len; n > 0 && i < len * 10; i++) {\\n                long p = createPalindrome(i, true);\\n                if (isPalindrome(p, k)) { sum += p; n--; }\\n            }\\n            for (long i = len; n > 0 && i < len * 10; i++) {\\n                long p = createPalindrome(i, false);\\n                if (isPalindrome(p, k)) { sum += p; n--; }\\n            }\\n        }\\n        return sum;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"sum-of-k-mirror-numbers","has_notes":false,"flag_type":1,"frontend_id":124},{"id":1672730800,"question_id":3754,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750602619,"status":10,"status_display":"Accepted","runtime":"56 ms","url":"/submissions/detail/1672730800/","is_pending":"Not Pending","title":"Maximum Manhattan Distance After K Changes","memory":"45.5 MB","code":"class Solution {\\n    public int maxDistance(String s, int k) {\\n        int ans = 0;\\n        int north = 0, south = 0, east = 0, west = 0;\\n        \\n        for (int i = 0; i < s.length(); i++) {\\n            char c = s.charAt(i);\\n            if (c == \'N\') north++;\\n            else if (c == \'S\') south++;\\n            else if (c == \'E\') east++;\\n            else if (c == \'W\') west++;\\n            \\n            int x = Math.abs(north - south);\\n            int y = Math.abs(east - west);\\n            int MD = x + y;      //MD =Manhattan Distance\\n            int dis = MD + Math.min(2 * k, i + 1 - MD); // Ensure changes are at most k\\n            ans = Math.max(ans, dis);\\n        }\\n        \\n        return ans;\\n    }\\n}","compare_result":"","title_slug":"maximum-manhattan-distance-after-k-changes","has_notes":false,"flag_type":1,"frontend_id":123},{"id":1672729538,"question_id":3754,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750602537,"status":10,"status_display":"Accepted","runtime":"56 ms","url":"/submissions/detail/1672729538/","is_pending":"Not Pending","title":"Maximum Manhattan Distance After K Changes","memory":"45.6 MB","code":"class Solution {\\n    public int maxDistance(String s, int k) {\\n        int ans = 0;\\n        int north = 0, south = 0, east = 0, west = 0;\\n        \\n        for (int i = 0; i < s.length(); i++) {\\n            char c = s.charAt(i);\\n            if (c == \'N\') north++;\\n            else if (c == \'S\') south++;\\n            else if (c == \'E\') east++;\\n            else if (c == \'W\') west++;\\n            \\n            int x = Math.abs(north - south);\\n            int y = Math.abs(east - west);\\n            int MD = x + y;      //MD =Manhattan Distance\\n            int dis = MD + Math.min(2 * k, i + 1 - MD); // Ensure changes are at most k\\n            ans = Math.max(ans, dis);\\n        }\\n        \\n        return ans;\\n    }\\n}","compare_result":"","title_slug":"maximum-manhattan-distance-after-k-changes","has_notes":false,"flag_type":1,"frontend_id":122},{"id":1672727884,"question_id":2260,"lang":"java","lang_name":"Java","time":"1\xc2\xa0year, 2\xc2\xa0months","timestamp":1750602429,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1672727884/","is_pending":"Not Pending","title":"Divide a String Into Groups of Size k","memory":"42.8 MB","code":"class Solution {\\n    public String[] divideString(String s, int k, char fill) {\\n        int n = s.length();\\n        int groups = (n + k - 1) / k;\\n        String[] result = new String[groups];\\n        \\n        for (int i = 0; i < groups; i++) {\\n            StringBuilder group = new StringBuilder();\\n            for (int j = 0; j < k; j++) {\\n                int index = i * k + j;\\n                if (index < n) {\\n                    group.append(s.charAt(index));\\n                } else {\\n                    group.append(fill); // Padding\\n                }\\n            }\\n            result[i] = group.toString();\\n        }\\n        \\n        return result;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"divide-a-string-into-groups-of-size-k","has_notes":false,"flag_type":1,"frontend_id":121}],"has_next":true,"last_key":""}'
